---
/* À propos — gabarit 10 (réf. docs/handoff/reference/a-propos.html, piste 2d).
   7 sections, alternance : encre (héros .estimate) → blanc #equipe →
   tendre charte → blanc méthode → blanc (cont) maillage → tendre agence →
   tendre (cont) CTA estimation. Le footer encre suit.

   Copie reprise mot pour mot de la référence, sauf :
   · « depuis 2021 » (Liège) → « depuis 2024 » — /communes (F4) a figé
     « Liège depuis 2024 » ; deux pages en ligne ne peuvent pas se contredire ;
   · 89 % / 87 % couverts par la ligne « À sourcer — valeurs maquette »
     (même précédent que les preuves de l'accueil) ; 4,8/5 · 190 avis =
     chiffres externes Google, repris tels quels (précédent accueil, /biens) ;
     « depuis 1992 » = fait d'entreprise.

   Chaque lien de localité ou de listing est GARDÉ au build (lienLocalite /
   lienBiens, motif de /communes) : jamais de lien vers une combinaison vide.
   La page émet son RealEstateAgent complet → organizationLd={false}. */
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Breadcrumb from "../components/core/Breadcrumb.astro";
import Eyebrow from "../components/core/Eyebrow.astro";
import LinkArrow from "../components/core/LinkArrow.astro";
import LocalityLinks from "../components/core/LocalityLinks.astro";
import MemberContactCard from "../components/surfaces/MemberContactCard.astro";
import Commitments from "../components/surfaces/Commitments.astro";
import AgencyCard from "../components/surfaces/AgencyCard.astro";
import SellHere from "../components/surfaces/SellHere.astro";
import { jsonLd } from "../lib/seo";
import { combinaisons, slugCombinaison, slugCommune } from "../lib/maillage";

/* ── Collections ── */
const equipe = (await getCollection("equipe")).sort((a, b) => a.data.ordre - b.data.ordre);
const biens = await getCollection("biens", ({ data }) => data.publie !== false);
const communes = await getCollection("communes");
const articles = await getCollection("articles", ({ data }) => data.publie !== false);
type Bien = (typeof biens)[number];

/* ── Routes de localité réellement générées (déclarées ∩ non vides) —
   mêmes règles que getStaticPaths de [type]-a-[transaction]-[commune]. ── */
const declarees = new Set(
  communes.flatMap((c) =>
    c.data.combinaisons.map(({ type, transaction }) =>
      slugCombinaison(type, transaction, slugCommune(c.data.nom)),
    ),
  ),
);
const routesLocalite = combinaisons(
  biens.map(({ data }) => ({ type: data.type, transaction: data.transaction, commune: data.commune })),
).filter((c) => declarees.has(c.slug));

/* Garde : un lien vers une page de localité doit viser une route générée. */
const lienLocalite = (text: string, slug: string) => {
  if (!routesLocalite.some((c) => c.slug === slug))
    throw new Error(`/a-propos : « ${text} » pointe vers /${slug}, route non générée.`);
  return { text, href: `/${slug}` };
};

/* Garde : un lien /biens?cat=…&loc=…&type=… doit avoir au moins un bien
   publié derrière (contrat d'URL de /biens, conventions de /communes). */
const locSlugDe = (commune: string) => {
  const s = slugCommune(commune);
  return s === "charleroi-centre" ? "charleroi" : s;
};
const catDe = (b: Bien) =>
  b.data.statut === "vendu" ? "vendu" : b.data.transaction === "location" ? "location" : "vente";
const typeSlugDe = (b: Bien) => (b.data.sousType === "villa" ? "villa" : b.data.type);
const lienBiens = (text: string, cat: string, loc?: string, type?: string) => {
  const ok = biens.some(
    (b) =>
      catDe(b) === cat &&
      (!loc || locSlugDe(b.data.commune) === loc) &&
      (!type || typeSlugDe(b) === type),
  );
  if (!ok)
    throw new Error(`/a-propos : « ${text} » (cat=${cat}, loc=${loc}, type=${type}) sans bien publié.`);
  const q = [`cat=${cat}`, loc && `loc=${loc}`, type && `type=${type}`].filter(Boolean).join("&");
  return { text, href: `/biens?${q}` };
};

/* Garde : les liens d'articles reprennent le titre RÉEL de la collection. */
const lienArticle = (id: string) => {
  const a = articles.find((x) => x.id === id);
  if (!a) throw new Error(`/a-propos : article « ${id} » introuvable ou non publié.`);
  return { text: a.data.titre, href: `/blog/${a.id}` };
};

/* ── 3 · La charte : cinq engagements écrits (texte de la référence). ── */
const engagements = [
  {
    titre: "Une estimation écrite, jamais une fourchette lancée en visite.",
    texte: "Comparables réels, état du bien, tension du quartier. Remise sous 48 h, gratuite, sans engagement.",
  },
  {
    titre: "Un seul interlocuteur, de l'estimation à l'acte.",
    texte: "La personne qui estime fait visiter, négocie et vous accompagne chez le notaire. Son numéro direct est sur le mandat.",
  },
  {
    titre: "Un dossier qui montre tout avant la première visite.",
    texte: "Photos professionnelles, vidéo, plans 2D et 3D, surfaces vérifiées. L'acquéreur qui se déplace sait déjà ce qu'il vient voir.",
  },
  {
    titre: "Des acquéreurs vérifiés, pas des curieux.",
    texte: "Capacité de financement contrôlée avant toute offre. C'est ce qui explique zéro litige judiciaire en vingt-cinq ans.",
  },
  {
    titre: "Des honoraires dus uniquement si la vente se fait.",
    texte: "Fixés au mandat, selon le bien et les prestations retenues. Rien avant, rien de plus après.",
  },
];

/* ── 4 · Méthode : deux colonnes .lx, liens réels (estimation, blog, hub). ── */
const lxCols = [
  {
    label: "Notre méthode d'estimation",
    liens: [
      { text: "Commencer par une estimation écrite", href: "/estimation" },
      lienArticle("pourquoi-98-pourcent-au-prix-estime"),
      lienArticle("prix-de-depart-erreur-trois-mois"),
    ],
  },
  {
    label: "Les prix, commune par commune",
    liens: [
      lienArticle("gerpinnes-loverval-nalinnes-prix-2026"),
      lienArticle("prestige-charleroi-prix-2026"),
      { text: "Toutes nos communes, avec leurs chiffres", href: "/communes" },
    ],
  },
];

/* ── 5 · Maillage : groupes du mesh, ancres descriptives, liens gardés.
   Sans compteurs — règle du hub des localités (F4) : pas de chiffre non
   sourcé, les compteurs de la maquette (12, 9, 46…) ne sont pas repris. ── */
const meshGroups = [
  {
    label: "Grand Charleroi",
    links: [
      lienLocalite("Immobilier à Gerpinnes", "maison-a-vendre-gerpinnes"),
      lienBiens("Maisons à vendre à Loverval", "vente", "loverval", "maison"),
      lienBiens("Maisons à vendre à Mont-sur-Marchienne", "vente", "mont-sur-marchienne", "maison"),
      lienBiens("Appartements à vendre à Charleroi", "vente", "charleroi", "appartement"),
      lienBiens("Villas à vendre à Nalinnes", "vente", "nalinnes", "villa"),
      lienBiens("Maisons à vendre à Marcinelle", "vente", "marcinelle", "maison"),
    ],
  },
  {
    label: "Liège",
    links: [
      lienLocalite("Maisons à vendre à Liège", "maison-a-vendre-liege"),
      lienLocalite("Appartements à louer à Liège", "appartement-a-louer-liege"),
    ],
  },
  {
    label: "Par intention",
    links: [
      { text: "Estimer mon bien", href: "/estimation" },
      { text: "Tous nos biens", href: "/biens" },
      { text: "Conseils & marché", href: "/blog" },
      { text: "Avis clients", href: "/avis" },
    ],
  },
];

/* ── 6 · Agence (coordonnées de la maquette ; Bd Tirou = adresse du chrome).
   lat/lng : Boulevard Tirou 102, valeurs approchées — à confirmer avant
   mise en ligne (aucune coordonnée du siège dans les collections). ── */
const AGENCE = {
  nom: "Avenir Immobilier — Charleroi",
  adresse: "Boulevard Tirou 102, 6000 Charleroi",
  note: "à 400 m de la gare de Charleroi-Sud · parking dans la cour",
  ouverture: "Ouvert aujourd'hui jusque 18h30",
  tel: "+32 71 32 14 70",
  email: "contact@avenir-immobilier.be",
  horaires: "Lun–Ven 9h–18h30 · Sam 10h–16h",
  agrements: "IPI 509 217 · TVA BE 0712.xxx.xxx",
  lat: 50.4076,
  lng: 4.4418,
};
const zonesAgence = [
  lienLocalite("Immobilier à Gerpinnes", "maison-a-vendre-gerpinnes"),
  lienBiens("Appartements à vendre à Charleroi", "vente", "charleroi", "appartement"),
  lienBiens("Maisons à vendre à Loverval", "vente", "loverval", "maison"),
  lienBiens("Maisons à vendre à Mont-sur-Marchienne", "vente", "mont-sur-marchienne", "maison"),
  lienLocalite("Maisons à vendre à Liège", "maison-a-vendre-liege"),
  lienLocalite("Appartements à louer à Liège", "appartement-a-louer-liege"),
].map((l) => ({ label: l.text, href: l.href }));

/* ── Head : title/description de la référence + JSON-LD complet. ── */
const title = "À propos — Avenir Immobilier, agence immobilière indépendante à Charleroi depuis 1992";
const description =
  "Agence immobilière indépendante à Charleroi depuis 1992 : six personnes, un numéro direct chacune. Qui fait quoi dans l'équipe, nos cinq engagements écrits, les communes que nous couvrons de Gerpinnes à Liège, et où nous trouver boulevard Tirou.";
const canonical = new URL("/a-propos", Astro.site).href;

/** « 0475/52.26.31 » → « +32475522631 » (même normalisation que la carte). */
const telInt = (t: string) => `+32${t.replace(/\D/g, "").replace(/^0/, "")}`;

/* RealEstateAgent + PostalAddress + AggregateRating + employee[] — mêmes
   données que le HTML affiché (héros, cartes membres, carte agence).
   4,8/190 = chiffre externe Google, repris tel quel (précédent accueil). */
const agentLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Avenir Immobilier",
  url: Astro.site?.href ?? "https://www.lavenir-immobilier.be/",
  telephone: AGENCE.tel,
  email: AGENCE.email,
  foundingDate: "1992",
  numberOfEmployees: String(equipe.length),
  image: new URL("/assets/equipe-avenir.png", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Boulevard Tirou 102",
    postalCode: "6000",
    addressLocality: "Charleroi",
    addressCountry: "BE",
  },
  openingHours: ["Mo-Fr 09:00-18:30", "Sa 10:00-16:00"],
  areaServed: ["Charleroi", "Gerpinnes", "Loverval", "Mont-sur-Marchienne", "Liège", "Namur"],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.8", reviewCount: "190" },
  employee: equipe.map((m) => ({
    "@type": "Person",
    name: m.data.nom,
    jobTitle: m.data.fonction,
    ...(m.data.telephone ? { telephone: telInt(m.data.telephone) } : {}),
    ...(m.data.email ? { email: m.data.email } : {}),
    url: new URL(`/equipe/${m.id}`, Astro.site).href,
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "À propos", item: canonical },
  ],
};

const delay = (i: number) => (i % 3 === 1 ? " d1" : i % 3 === 2 ? " d2" : "");
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  active="/a-propos"
  organizationLd={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd(agentLd)} />
    <script type="application/ld+json" is:inline set:html={jsonLd(breadcrumbLd)} />
  </Fragment>

  <!-- ============ 1 · HÉROS ENCRE (.estimate) — fil d'Ariane, H1, chiffres, photo d'équipe ============ -->
  <section class="estimate on-dark">
    <div class="wrap">
      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "À propos" }]} />
      <div class="est-grid about-hero">
        <div class="est-copy reveal">
          <Eyebrow>Agence immobilière à Charleroi · depuis 1992</Eyebrow>
          <h1>Six personnes, <strong>un numéro direct</strong> chacune.</h1>
          <p class="lede">Avenir Immobilier est une agence indépendante, installée boulevard Tirou depuis vingt-cinq ans. Pas de réseau, pas de franchise, pas de standard : la personne qui estime votre bien est celle qui le vend, et vous avez son numéro.</p>
        </div>
        <div class="reveal d1 grid gap-3.5">
          <dl class="about-dl">
            <div><dt>Fondée à Charleroi en</dt><dd>1992</dd></div>
            <div><dt>Biens vendus en moins d'un mois</dt><dd>89 %</dd></div>
            <div><dt>Vendus au-dessus du prix affiché</dt><dd>87 %</dd></div>
            <div><dt>Avis Google · 190 avis</dt><dd>4,8<small>/5</small></dd></div>
          </dl>
          <span class="sell-src">89 % et 87 % : à sourcer — valeurs maquette · 23 septembre 2026</span>
          <div class="mt-1 flex flex-wrap gap-3.5">
            <a href="#equipe" class="btn">Qui fait quoi <span class="arr">↓</span></a>
            <a href="/estimation" class="btn btn--ghost">Estimer mon bien</a>
          </div>
        </div>
      </div>
      <figure class="reveal d2 about-photo">
        <img src="/assets/equipe-avenir.png" alt="L'équipe Avenir Immobilier au complet, réunie dans le parc de Loverval" width="1600" height="1209" />
        <figcaption>L'équipe au complet · été 2026</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ 2 · QUI FAIT QUOI (blanc) — six cartes contact ============ -->
  <section class="sec--white" id="equipe">
    <div class="wrap">
      <div class="props-head reveal">
        <div class="section-head m-0">
          <Eyebrow>Qui fait quoi</Eyebrow>
          <h2>Appelez directement la bonne personne</h2>
          <p>Cinq agents et une office manager, chacun avec son numéro direct. La personne qui décroche est celle qui suivra votre dossier jusqu'à l'acte.</p>
        </div>
        <LinkArrow href="/equipe">Toute l'équipe</LinkArrow>
      </div>
      <div class="team-grid team-grid--contact mt-[clamp(26px,3.4vw,40px)]">
        {equipe.map((m, i) => <MemberContactCard membre={m} class={`reveal${delay(i)}`} />)}
      </div>
    </div>
  </section>

  <!-- ============ 3 · LA CHARTE (vert tendre) — cinq engagements écrits ============ -->
  <section class="sec--tint">
    <div class="wrap two-col two-col--a">
      <div class="reveal sticky-side">
        <Eyebrow>Notre charte</Eyebrow>
        <h2 class="mt-3.5">Ce que vous pouvez exiger de nous</h2>
        <p class="text-ink-soft mt-3.5 max-w-[44ch]">Cinq engagements écrits, les mêmes depuis 1992. Ils figurent sur chaque mandat que nous signons — et vous pouvez nous les rappeler à tout moment.</p>
        <a href="/estimation" class="btn mt-6.5">Commencer par une estimation <span class="arr">→</span></a>
      </div>
      <Commitments items={engagements} class="reveal d1" />
    </div>
  </section>

  <!-- ============ 4 · LA MÉTHODE (blanc) — le prix d'une rue ============ -->
  <section class="sec--white">
    <div class="wrap two-col two-col--b">
      <div class="reveal">
        <Eyebrow>Là où nous travaillons</Eyebrow>
        <h2 class="mt-3.5">Le prix d'une rue, pas seulement d'un code postal</h2>
        <p class="text-ink-soft mt-3.5 max-w-[44ch]">Nous ne couvrons pas « toute la Wallonie ». Nous couvrons les communes où nous avons vendu assez de biens pour connaître le prix d'une rue. Chacune a sa page, avec ses chiffres, ses biens disponibles et le conseiller qui la suit.</p>
        <p class="text-ink-soft mt-3 max-w-[44ch]">Le Grand Charleroi d'abord, depuis 1992. Puis Namur et <a href="/maison-a-vendre-liege" class="text-green-d font-semibold">Liège</a>, où l'équipe vend et loue depuis 2024.</p>
      </div>
      <div class="lx lx--two reveal d1">
        {lxCols.map((col) => (
          <div class="lx-col">
            <span class="ll-lab">{col.label}</span>
            <ul class="lx-list">
              {col.liens.map((l) => (
                <li><a href={l.href}>{l.text}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 5 · LE MAILLAGE (blanc, continuation) — chercher là où nous vendons ============ -->
  <section class="sec--white sec--cont">
    <div class="wrap">
      <LocalityLinks
        variant="mesh"
        class="reveal"
        eyebrow="Nos pages par commune"
        title="Chercher là où nous vendons"
        groups={meshGroups}
      />
    </div>
  </section>

  <!-- ============ 6 · L'AGENCE (vert tendre) — boulevard Tirou ============ -->
  <section class="sec--tint">
    <div class="wrap two-col two-col--c">
      <div class="reveal">
        <Eyebrow>Nous recevons ici</Eyebrow>
        <h2 class="mt-3.5">Boulevard Tirou, depuis le premier jour</h2>
        <p class="text-ink-soft mt-3.5 max-w-[46ch]">À quatre cents mètres de la gare de Charleroi-Sud. Passez sans rendez-vous du lundi au vendredi : il y a toujours un conseiller à l'agence. Parking gratuit dans la cour, rez-de-chaussée accessible.</p>
        <div class="loc-figs">
          <div class="lf"><span class="lf-v">9h–18h30</span><span class="lf-k">En semaine, sans rendez-vous</span></div>
          <div class="lf"><span class="lf-v">10h–16h</span><span class="lf-k">Le samedi</span></div>
          <div class="lf"><span class="lf-v">400 m</span><span class="lf-k">De la gare de Charleroi-Sud</span></div>
          <div class="lf"><span class="lf-v">Gratuit</span><span class="lf-k">Parking dans la cour</span></div>
        </div>
        <div class="enclair mt-7.5">
          <span class="e-tag">Nous recrutons</span>
          <p>Un·e conseiller·ère pour Liège, IPI ou stagiaire IPI. Si vous connaissez le prix d'une rue à Cointe ou à Outremeuse, <a href="/contact" class="text-green-d font-semibold">écrivez à Olivier</a>.</p>
        </div>
      </div>
      <AgencyCard
        class="reveal d1"
        media="map"
        mediaLabel="Plan — Boulevard Tirou 102, Charleroi"
        lat={AGENCE.lat}
        lng={AGENCE.lng}
        zoom={16}
        open={AGENCE.ouverture}
        name={AGENCE.nom}
        address={AGENCE.adresse}
        note={AGENCE.note}
        rows={[
          { label: "Téléphone", value: AGENCE.tel, href: `tel:${AGENCE.tel.replace(/[^+0-9]/g, "")}` },
          { label: "Email", value: AGENCE.email, href: `mailto:${AGENCE.email}` },
          { label: "Horaires", value: AGENCE.horaires },
          { label: "Agréments", value: AGENCE.agrements },
        ]}
        phone={AGENCE.tel}
        directionsHref="https://maps.google.com/?q=Boulevard+Tirou+102+6000+Charleroi"
        directionsLabel="Itinéraire"
        directionsArrow="↗"
        zones={zonesAgence}
        zonesLabel="Zones d'intervention"
      />
    </div>
  </section>

  <!-- ============ 7 · CTA ESTIMATION (vert tendre, continuation) — SellHere compact ============ -->
  <section class="sec--tint sec--cont">
    <div class="wrap">
      <SellHere
        variant="compact"
        class="reveal mx-auto"
        eyebrow="Vous savez maintenant à qui vous parlez"
        title={"Combien vaut votre bien aujourd'hui ?"}
        lede="Estimation gratuite, rapport écrit sous 48 h, aucun engagement. La personne qui l'écrit est celle qui vendra."
        primaryLabel="Estimer mon bien"
        primaryHref="/estimation"
        secondaryLabel=""
      />
    </div>
  </section>
</PageLayout>

<style is:global>
@layer ds {
  /* ── À propos — recopies de la référence a-propos.html (styles inline de la
     page), valeurs inchangées. local.css ne porte que les surcharges mobiles
     de .about-hero/.about-dl/.about-photo : la base manque — à reprendre dans
     le DS à la prochaine synchro. ── */
  .est-grid.about-hero { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: end; margin-top: 18px; }
  .estimate .about-hero h1 { font-size: clamp(38px, 5.2vw, 68px); max-width: 14ch; }
  .about-hero .about-dl { margin: 0; display: grid; gap: 0; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .about-hero .about-dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding: 14px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .about-hero .about-dl dt { font-size: 15px; color: rgba(255, 255, 255, 0.72); }
  .about-hero .about-dl dd { margin: 0; font-family: var(--serif); font-weight: 700; font-size: 26px; color: var(--yellow); letter-spacing: -0.02em; }
  .about-hero .about-dl dd small { font-size: 55%; color: rgba(255, 255, 255, 0.6); }
  .about-photo { margin: clamp(34px, 4.5vw, 60px) 0 0; position: relative; border-radius: var(--r); overflow: hidden; aspect-ratio: 2.4 / 1; background: var(--ink-bg); }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 24%; }
  .about-photo figcaption { position: absolute; left: 18px; bottom: 18px; background: rgba(255, 255, 255, 0.94); color: var(--ink); border-radius: 100px; padding: 8px 16px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }

  /* Fil d'Ariane inversé sur l'encre du héros — mêmes valeurs que
     .page-head--band/--ink (site.css) ; à reprendre dans le DS sous le
     crochet .on-dark (qui ne couvre aujourd'hui que .btn--ghost). */
  .estimate.on-dark .breadcrumb a { color: rgba(255, 255, 255, 0.72); }
  .estimate.on-dark .breadcrumb a:hover { color: #fff; }
  .estimate.on-dark .breadcrumb .cur { color: #fff; }
  .estimate.on-dark .breadcrumb .sep { color: rgba(255, 255, 255, 0.34); }

  /* Ligne de source des chiffres du héros : .sell-src est encre sur encre. */
  .about-hero .sell-src { color: rgba(255, 255, 255, 0.72); margin-top: 0; }

  /* Index méthode : .lx à deux colonnes (le DS n'en connaît que trois). */
  .lx.lx--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 860px) {
    .lx.lx--two { grid-template-columns: 1fr; }
  }

  /* Encart recrutement sur section teintée : teinté sur teinté = invisible —
     blanc bordé --line (règle DS n° 4, même motif que .page-head--tint). */
