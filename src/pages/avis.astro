---
/* Page avis — gabarit 09. Réf. : docs/handoff/reference/avis.html.

   Sections : 1 en-tête plain (fil d'Ariane + .av-hero : H1, chapô, actions,
   panneau bicolore .sum-c, ligne .av-sync) · 2 #mur — mur d'avis sur fond
   vert tendre (fond déclaré par #mur dans local.css, pas de .sec-- redoublé)
   · 3 CTA final en aplat vert profond (FinalCta tone="deep", .on-dark sur
   les actions). Alternance : blanc → tendre → vert profond.

   Contenu : collection `avis` triée du plus récent au plus ancien — les
   {VISIBLE} plus récents affichés, le reste réel derrière « En voir plus »
   (comptes des filtres et du mur CALCULÉS, jamais recopiés de la maquette,
   qui annonçait 12 cartes pour 17 entrées réelles). 4,8/5 · 190 avis et la
   distribution 167/16/5/1/1 = chiffres EXTERNES Google, repris tels quels
   (précédent accueil, /biens, /estimation) ; la ligne .av-sync porte la date
   de synchronisation (12 septembre 2026), même source que chaque entrée.

   JSON-LD : RealEstateAgent complet + AggregateRating (4,8 · 190) +
   Review × n AFFICHÉS, mot pour mot → organizationLd={false}. */
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import PageHead from "../components/chrome/PageHead.astro";
import Breadcrumb from "../components/core/Breadcrumb.astro";
import Eyebrow from "../components/core/Eyebrow.astro";
import FinalCta from "../components/surfaces/FinalCta.astro";
import ReviewWall from "../components/surfaces/ReviewWall.astro";
import { jsonLd } from "../lib/seo";

const GOOGLE_URL = "https://www.google.com/maps/search/Avenir+Immobilier+Charleroi";
/* Note et volume de la fiche Google — données externes reprises telles
   quelles, avec la distribution par étoiles de la même fiche. */
const NOTE = "4,8";
const TOTAL = 190;
const DISTRIBUTION = [
  { stars: 5, count: 167, width: 100 },
  { stars: 4, count: 16, width: 10 },
  { stars: 3, count: 5, width: 3 },
  { stars: 2, count: 1, width: 2 },
  { stars: 1, count: 1, width: 2 },
];

/* ── Collection triée du plus récent au plus ancien (départage par id) ── */
const collection = await getCollection("avis");
const avis = [...collection].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id, "fr"),
);
const VISIBLE = Math.min(12, avis.length);

/* ── Filtres : comptes réels par type de projet ── */
const CHIPS: Record<string, string> = {
  vente: "Vente",
  achat: "Achat",
  estimation: "Estimation",
  offmarket: "Off-market",
};
const filtres = [
  { id: "all", label: "Tous", count: avis.length },
  ...Object.entries(CHIPS)
    .map(([id, label]) => ({ id, label, count: avis.filter((a) => a.data.projet === id).length }))
    .filter((f) => f.count > 0),
];

/* Étiquettes des photos jointes — placeholders .ph en attendant les visuels
   (légendes de la référence quand elle en donne, « Photo n » sinon, même
   précédent que l'accueil). */
const PHOTO_TAGS: Record<string, string[]> = {
  "famille-declercq": ["Photo de l'avis · façade", "Jardin"],
  "famille-op-de-beeck": ["Remise des clés", "Séjour", "Vue"],
  "a-petit": ["Photo de l'avis · avant / après staging"],
};

const mois = new Intl.DateTimeFormat("fr-BE", { month: "short", year: "numeric", timeZone: "UTC" });
const cartes = avis.map((a) => ({
  id: a.id,
  auteur: a.data.auteur,
  note: a.data.note,
  texte: a.data.texte,
  place: (a.body ?? "").trim() || a.data.commune || "",
  cat: a.data.projet,
  chip: a.data.projet ? (CHIPS[a.data.projet] ?? a.data.projet) : undefined,
  dateLabel: mois.format(a.data.date),
  reponse: a.data.reponse,
  photos: a.data.photos
    ? (PHOTO_TAGS[a.id] ?? Array.from({ length: a.data.photos }, (_, i) => `Photo ${i + 1}`))
    : undefined,
}));

/* ── Head : title/description de la référence, canonical /avis ── */
const title = "Avis clients — 4,8/5 sur Google · Avenir Immobilier";
const description =
  "190 avis Google vérifiés de vendeurs et d'acquéreurs accompagnés par Avenir Immobilier à Charleroi. Note globale 4,8/5 — tous les avis sont repris de Google, sans tri ni réécriture.";
const canonical = new URL("/avis", Astro.site).href;

/* RealEstateAgent complet (mêmes coordonnées que /contact) + AggregateRating
   4,8/190 (externe Google) + Review × n affichés, mot pour mot. */
const agentLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Avenir Immobilier",
  url: new URL("/", Astro.site).href,
  telephone: "+3271321470",
  email: "contact@avenir-immobilier.be",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Boulevard Tirou 102",
    postalCode: "6000",
    addressLocality: "Charleroi",
    addressCountry: "BE",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "18:30",
    },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "16:00" },
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.8", reviewCount: String(TOTAL) },
  review: avis.slice(0, VISIBLE).map((a) => ({
    "@type": "Review",
    author: { "@type": "Person", name: a.data.auteur },
    reviewRating: { "@type": "Rating", ratingValue: String(a.data.note), bestRating: "5" },
    datePublished: a.data.date.toISOString().slice(0, 10),
    reviewBody: a.data.texte,
  })),
};
---

<PageLayout title={title} description={description} canonical={canonical} organizationLd={false}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd(agentLd)} />
  </Fragment>

  {/* ── 1 · EN-TÊTE PLAIN — fil d'Ariane, héros bicolore .av-hero ── */}
  <PageHead>
    <Breadcrumb slot="breadcrumb" items={[{ label: "Accueil", href: "/" }, { label: "Avis clients" }]} />
    <div class="av-hero">
      <div>
        <Eyebrow>Ils nous font confiance</Eyebrow>
        <h1 class="av-title mt-4">
          Ce que nos clients disent, <em class="av-hl">sans filtre</em>.
        </h1>
        <p class="av-lede text-ink-soft mt-4.5 max-w-[56ch]">
          Chaque avis de cette page est repris automatiquement de notre fiche Google. Rien n'est
          réécrit, rien n'est retiré — les moins bons aussi.
        </p>
        <div class="fc-actions justify-start mt-7">
          <a href="/contact" class="btn">Parler à un conseiller <span class="arr">→</span></a>
          <a href={GOOGLE_URL} target="_blank" rel="noopener" class="btn btn--ghost">Voir la fiche Google ↗</a>
        </div>
      </div>
      <div class="sum-c">
        <div class="sc-side">
          <span class="v">{NOTE}</span>
          <span class="t-stars" aria-label={`${NOTE} étoiles sur 5`}>★★★★★</span>
          <span class="c">{TOTAL} avis · sur 5</span>
        </div>
        <div class="sc-body">
          <span class="sc-src"><svg class="t-glogo" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg> Avis Google vérifiés</span>
          <div class="ts-bars">
            {DISTRIBUTION.map((d) => (
              <div class="ts-bar">
                <span>{d.stars} ★</span>
                <span class="ts-track"><span class="ts-fill" style={`width:${d.width}%`}></span></span>
                <span class="n">{d.count}</span>
              </div>
            ))}
          </div>
          <div class="sc-cta">
            <a class="btn" href={GOOGLE_URL} target="_blank" rel="noopener">Laisser un avis <span class="arr">→</span></a>
            <span class="t-src">2 minutes, compte Google requis</span>
          </div>
        </div>
      </div>
    </div>
    <p class="av-sync">Synchronisé depuis Google · dernière mise à jour : 12 septembre 2026 · aucune modération par l'agence</p>
  </PageHead>

  {/* ── 2 · MUR D'AVIS — fond vert tendre déclaré par #mur (local.css),
       cartes blanches, avis vedette --hl, filtres aux comptes réels ── */}
  <section id="mur">
    <div class="wrap">
      <ReviewWall
        cartes={cartes}
        filtres={filtres}
        visible={VISIBLE}
        totalGoogle={TOTAL}
        googleUrl={GOOGLE_URL}
      />
    </div>
  </section>

  {/* ── 3 · CTA FINAL — aplat vert profond (.finalcta--deep, local.css).
       .on-dark sur les actions : le .btn--ghost passe en transparent bordé
       blanc (même motif que /contact). ── */}
  <FinalCta tone="deep">
    <span class="eyebrow center reveal">Votre projet, maintenant</span>
    <h2 class="reveal d1">Le prochain avis pourrait être <em>le vôtre</em>.</h2>
    <p class="reveal d2">Un premier échange offert, sans engagement — et une réponse sous 24 h.</p>
    <div class="fc-actions on-dark reveal d2">
      <a href="/contact" class="btn">Parler à un conseiller <span class="arr">→</span></a>
      <a href="/estimation" class="btn btn--ghost">Estimer mon bien</a>
    </div>
  </FinalCta>
</PageLayout>

<style is:global>
@layer ds {
  /* ── à reprendre dans le DS — héros de avis.html : styles inline du H1
     (taille), du surlignage <em> et du chapô (17 px), passés en classes. ── */
  .av-hero .av-title { font-size: clamp(36px, 4.8vw, 64px); }
  .av-hero .av-hl { font-style: normal; color: var(--green-l); }
  .av-hero .av-lede { font-size: 17px; }
  /* ── à reprendre dans le DS — gabarit 09 : <style> de page de avis.html
     (héros), valeurs inchangées. local.css porte déjà .sum-c/.sc-* et la
     couleur verte de .av-sync en page-head — seules les bases manquent. ── */
  .av-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 4.5vw, 64px); align-items: center; margin-top: clamp(24px, 3vw, 34px); }
  .av-sync { font-family: var(--mono); font-size: 11px; letter-spacing: .05em; color: var(--ink-mute); margin-top: 14px; text-transform: uppercase; }
  @media (max-width: 1020px) { .av-hero { grid-template-columns: 1fr; } }

  /* Défaut de contraste de la maquette : les libellés .ts-bar (site.css)
     sont blancs — prévus pour la synthèse sombre .trust-sum — et
     disparaissent sur le panneau blanc .sc-body. Règle DS n°3 : encre. */
  .sc-body .ts-bar { color: var(--ink-soft); }
}
</style>
