---
/* Banc de comparaison — calqué sur le catalogue « claude design ».
   Temporaire : à supprimer avant mise en production.

   Chaque carte reprend le nom, le sous-titre et les EXEMPLES de props des
   specimens `@dsCard` du design system, pour une comparaison visuelle 1:1.
   Les composants utilisent leurs classes DS ; le châssis de catalogue et les
   helpers de specimen (.row/.col/.lbl/.dark/.tint/.chip) sont en <style> scopé. */
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/actions/Button.astro";
import PropertyCard from "../components/surfaces/PropertyCard.astro";
import Eyebrow from "../components/core/Eyebrow.astro";
import LinkArrow from "../components/core/LinkArrow.astro";
import Breadcrumb from "../components/core/Breadcrumb.astro";
import Placeholder from "../components/core/Placeholder.astro";
import Pagination from "../components/core/Pagination.astro";
import Badge from "../components/surfaces/Badge.astro";
import SpecGrid from "../components/surfaces/SpecGrid.astro";
import PebScale from "../components/surfaces/PebScale.astro";
import Input from "../components/forms/Input.astro";
import Select from "../components/forms/Select.astro";
import Seg from "../components/forms/Seg.astro";
import ChoiceRow from "../components/forms/ChoiceRow.astro";
import AgentCard from "../components/surfaces/AgentCard.astro";
import ArticleHeader from "../components/surfaces/ArticleHeader.astro";
import ArticleCard from "../components/surfaces/ArticleCard.astro";
import Byline from "../components/surfaces/Byline.astro";
import AuthorBox from "../components/surfaces/AuthorBox.astro";
import AuthorHero from "../components/surfaces/AuthorHero.astro";
import MemberHero from "../components/surfaces/MemberHero.astro";
import AgencyCard from "../components/surfaces/AgencyCard.astro";
import TrustSection from "../components/surfaces/TrustSection.astro";
import SellHere from "../components/surfaces/SellHere.astro";
import LocalityLinks from "../components/core/LocalityLinks.astro";
import Faq from "../components/islands/Faq";
import ShareBar from "../components/islands/ShareBar";
import ContactForm from "../components/islands/ContactForm";
import DropdownMenu from "../components/islands/DropdownMenu";
import { getCollection, getEntry } from "astro:content";

/* Banc ArticleCard (contrat vague D : entrées de collection, plus de props
   libres) — les 5 articles les plus récents et leurs auteurs. */
const artBench = (await getCollection("articles"))
  .sort((a, b) => b.data.datePublication.valueOf() - a.data.datePublication.valueOf())
  .slice(0, 5);
const artAuteurs = await Promise.all(artBench.map((a) => getEntry(a.data.auteur)));

const href = (p: number) => `?page=${p}`;
---

<PageLayout title="Banc de comparaison — Avenir Immobilier" description="Catalogue de contrôle interne, à supprimer.">
  <section class="sec--white">
    <div class="max-w-page mx-auto px-gut py-16 catalog-wrap">
      <header class="cat-intro">
        <Eyebrow>Banc de comparaison</Eyebrow>
        <h1 class="display">Catalogue des composants portés</h1>
        <p class="cat-lede">
          Reproduit la présentation du catalogue <em>claude design</em> — mêmes titres,
          sous-titres et exemples que les specimens du design system. Les 12 composants
          portés (10 + Button + PropertyCard) ; les composants non encore portés sont
          signalés.
        </p>
      </header>

      <!-- ============================ COMPOSANTS ============================ -->
      <h2 class="cat-group">Composants</h2>
      <div class="catalog">

        <article class="spec-card">
          <div class="spec-card__head">
            <span class="spec-card__name">Boutons</span>
            <span class="spec-card__sub">Vert clair (défaut), vert profond, ghost, light — flèche au hover</span>
          </div>
          <div class="spec-card__stage">
            <div class="row">
              <span class="lbl">Fond clair</span>
              <Button>Estimer mon bien</Button>
              <Button variant="ghost">Voir tous les biens (28)</Button>
            </div>
            <div class="row dark on-dark">
              <span class="lbl">Fond sombre · .on-dark</span>
              <Button>Estimer mon bien</Button>
              <Button variant="ghost">Nous contacter</Button>
              <Button variant="light" arrow={false}>Light</Button>
            </div>
            <div class="row tint">
              <span class="lbl">Le vert clair est déjà pris par un aplat voisin → variant="deep"</span>
              <span class="chip">− 12 % ce mois</span>
              <Button variant="deep">Parler à un conseiller</Button>
            </div>
          </div>
        </article>

        <article class="spec-card">
          <div class="spec-card__head">
            <span class="spec-card__name">Éyebrow, lien &amp; placeholder</span>
            <span class="spec-card__sub">Sur-titres, liens flèche, placeholders photo</span>
          </div>
          <div class="spec-card__stage stage--2col">
            <div class="col">
              <Eyebrow>Sélection du moment</Eyebrow>
              <LinkArrow>Estimer gratuitement</LinkArrow>
              <Placeholder tag="Villa — Gerpinnes" ratio="16 / 7" />
            </div>
            <div class="col">
              <Placeholder green tag="Détail · Intérieur" ratio="16 / 10.5" />
            </div>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Navigation de pages</span>
            <span class="spec-card__sub">Breadcrumb, filtres segmentés, pagination</span>
          </div>
          <div class="spec-card__stage">
            <Breadcrumb items={[{ label: "Accueil", href: "#" }, { label: "Nos biens", href: "#" }, { label: "Villa — Gerpinnes" }]} />
            <Seg
              label="Je cherche à"
              options={[
                { id: "all", label: "Tout voir", count: 9 },
                { id: "vente", label: "Acheter", count: 6 },
                { id: "location", label: "Louer", count: 2 },
                { id: "vendu", label: "Déjà vendus", count: 1 },
              ]}
            />
            <Pagination pages={3} current={1} hrefFor={href} />
          </div>
        </article>

        <article class="spec-card">
          <div class="spec-card__head">
            <span class="spec-card__name">Formulaires</span>
            <span class="spec-card__sub">Input, Select + menu déroulant, choix exclusifs</span>
          </div>
          <div class="spec-card__stage">
            <div style="width:100%">
              <Input label="Code postal" placeholder="6000" />
              <Select label="Nombre de chambres" placeholder="Sélectionner…" options={["1 à 2", "3 à 4", "5 et plus"]} />
            </div>
            <div style="width:100%">
              <ChoiceRow label="Type de bien" options={["Maison", "Appartement", "Villa", "Terrain / autre"]} />
              <Select label="Budget" value="250 000 – 500 000 €" options={["< 250 000 €", "250 000 – 500 000 €", "> 500 000 €"]} />
            </div>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Blocs fiche bien</span>
            <span class="spec-card__sub">SpecGrid, échelle PEB, carte conseiller</span>
          </div>
          <div class="spec-card__stage stage--2col">
            <div class="col">
              <SpecGrid
                specs={[
                  { value: "5", label: "Chambres" },
                  { value: "3", label: "Salles de bains" },
                  { value: "420 m²", label: "Habitables" },
                  { value: "2 970 m²", label: "Terrain" },
                  { value: "2009", label: "Construction" },
                  { value: "2 voit.", label: "Garage" },
                ]}
              />
              <PebScale grade="B" value="142 kWh/m²·an" />
            </div>
            <div class="col">
              <AgentCard
                name="Julien Schmitz"
                role="Votre conseiller — sud de Charleroi"
                tel="+32 71 32 14 70"
                points={["Réponse sous 24 h", "Visites 6 j/7", "Sans engagement"]}
              >
                <form onsubmit="return false">
                  <Input label="Nom" placeholder="Votre nom" />
                  <div style="margin-top:14px"><Button block>Organiser une visite</Button></div>
                </form>
              </AgentCard>
            </div>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Carte bien &amp; badges</span>
            <span class="spec-card__sub">L'élément signature — prix, localité, specs</span>
          </div>
          <div class="spec-card__stage stage--2col">
            <PropertyCard
              price="745 000 €"
              location="Gerpinnes"
              title="Villa d'architecte, lisière de bois"
              specs={["5 chambres", "420 m²", "Piscine"]}
              badge="Nouveau"
              badgeVariant="new"
              tag="Villa contemporaine — Gerpinnes"
            />
            <div class="col">
              <PropertyCard
                price="1 450 €"
                suffix="/ mois"
                location="Charleroi"
                title="Loft d'angle sur cour pavée"
                specs={["2 chambres", "140 m²"]}
                tag="Loft d'angle — Charleroi"
              />
              <div class="badges">
                <Badge variant="new">Nouveau</Badge>
                <Badge>Sous offre</Badge>
                <Badge variant="sold">Vendu</Badge>
              </div>
            </div>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Carte bien — variantes</span>
            <span class="spec-card__sub">défaut (grilles) · overlay (mise en avant) · horizontale (vues denses)</span>
          </div>
          <div class="spec-card__stage stage--2col">
            <PropertyCard
              price="745 000 €"
              location="Gerpinnes"
              title="Villa d'architecte, lisière de bois"
              specs={["5 chambres", "420 m²", "Piscine"]}
              badge="Nouveau"
              badgeVariant="new"
              tag="Villa contemporaine — Gerpinnes"
            />
            <PropertyCard
              variant="overlay"
              price="745 000 €"
              location="Gerpinnes"
              title="Villa d'architecte, lisière de bois"
              specs={["5 ch.", "420 m²", "Piscine"]}
              badge="Nouveau"
              badgeVariant="new"
              tag="Villa — Gerpinnes"
            />
            <div class="v-full">
              <PropertyCard
                variant="horizontal"
                price="595 000 €"
                location="Loverval"
                title="Maison de maître Belle Époque restaurée"
                specs={["6 chambres", "340 m²", "Jardin"]}
                badge="Sous offre"
                tag="Hôtel de maître — Loverval"
              />
            </div>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Article</span>
            <span class="spec-card__sub">ArticleHeader (large / condensé) + ArticleCard (mise en avant / compacte)</span>
          </div>
          <div class="spec-card__stage">
            <span class="lbl">ArticleHeader — large (sans média)</span>
            <ArticleHeader
              category="Marché"
              date="14 septembre 2026"
              title="Prix de l'immobilier à Charleroi : ce que révèle la rentrée 2026"
              lede="Nous avons repris les transactions de nos six conseillers, quartier par quartier, pour dire où les prix tiennent et où ils reculent."
              author={{ name: "Camille Renard", role: "Responsable ventes" }}
              readTime="6 min de lecture"
              showMedia={false}
            />
            <span class="lbl">ArticleCard — variant="feature"</span>
            <ArticleCard variant="feature" article={artBench[0]} auteur={artAuteurs[0]} />
            <span class="lbl">ArticleCard — variant="compact" (défaut · tint · thumb)</span>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;width:100%">
              <ArticleCard variant="compact" article={artBench[1]} auteur={artAuteurs[1]} />
              <ArticleCard variant="compact" tint article={artBench[2]} auteur={artAuteurs[2]} />
              <ArticleCard variant="compact" thumb article={artBench[3]} />
              <ArticleCard variant="compact" thumb article={artBench[4]} />
            </div>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Auteurs</span>
            <span class="spec-card__sub">Byline, encadré fin d'article, en-tête de page auteur</span>
          </div>
          <div class="spec-card__stage">
            <span class="lbl">Byline — tête d'article / carte blog</span>
            <div class="row" style="gap:40px">
              <Byline name="Claire Fontaine" role="Co-fondatrice" meta="12 mai 2026 · 4 min de lecture" href="#" />
              <Byline name="Marc Delvaux" small meta="8 mai 2026" />
            </div>
            <span class="lbl">Encadré fin d'article</span>
            <AuthorBox
              name="Claire Fontaine"
              role="Co-fondatrice"
              bio="Claire estime et vend des biens d'exception dans le Grand Charleroi depuis 1998. Elle signe nos analyses de marché et guides vendeurs."
              href="#"
            />
            <span class="lbl">En-tête de page auteur</span>
            <AuthorHero
              name="Claire Fontaine"
              role="Co-fondatrice · Agent IPI"
              bio="25 ans d'immobilier de prestige dans le Grand Charleroi. Claire signe nos analyses de marché, guides vendeurs et conseils d'estimation."
              meta={["18 articles", "Chez Avenir depuis 1998"]}
            >
              <a class="btn" href="#">Me contacter <span class="arr">→</span></a>
              <a class="btn btn--ghost" href="#">Tous ses articles</a>
            </AuthorHero>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Équipe — page membre</span>
            <span class="spec-card__sub">MemberHero (agent associé aux biens) — distinct des auteurs du blog</span>
          </div>
          <div class="spec-card__stage">
            <MemberHero
              name="Claire Fontaine"
              role="Co-fondatrice · Agent IPI 509 217"
              bio="25 ans d'immobilier de prestige dans le Grand Charleroi. Claire accompagne vendeurs et acquéreurs sur les biens d'exception."
              meta={["Chez Avenir depuis 1998", "FR · NL · EN"]}
              points={["Biens d'exception & maisons de maître", "Estimations certifiées"]}
              stats={[{ value: "120+", label: "biens vendus" }, { value: "25 ans", label: "d'expérience" }]}
            >
              <a class="btn" href="#">Me contacter <span class="arr">→</span></a>
              <a class="btn btn--ghost" href="#">Ses biens en vente</a>
            </MemberHero>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Agence</span>
            <span class="spec-card__sub">AgencyCard — vitrine ou plan, coordonnées, zones d'intervention</span>
          </div>
          <div class="spec-card__stage stage--2col">
            <AgencyCard
              name="Avenir Immobilier"
              tag="Agence · Charleroi"
              address="Rue Saint-Gilles 118 · 6000 Charleroi"
              note="à 5 min de la gare"
              rows={[{ label: "Horaires", value: "Lun–Ven 9h–18h · Sam 10h–13h" }, { label: "E-mail", value: "bonjour@avenir-immobilier.be" }]}
              phone="+32 71 32 14 70"
              zones={[{ label: "Gerpinnes", href: "#" }, { label: "Loverval", href: "#" }, { label: "Mont-sur-Marchienne", href: "#" }, { label: "Charleroi", href: "#" }]}
            />
            <AgencyCard
              media="map"
              lat={50.4093}
              lng={4.4385}
              zoom={15}
              name="Avenir Immobilier"
              open="Ouvert jusqu'à 18h"
              address="Rue Saint-Gilles 118 · 6000 Charleroi"
              rows={[{ label: "Tél.", value: "+32 71 32 14 70" }, { label: "Conseillers", value: "6" }]}
              directionsLabel="Ouvrir dans Maps"
              zones={[{ label: "Gerpinnes", href: "#" }, { label: "Loverval", href: "#" }]}
            />
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Section trust</span>
            <span class="spec-card__sub">TrustSection — synthèse + avis, note et barres jaunes sur aplat vert</span>
          </div>
          <div class="spec-card__stage">
            <span class="lbl">variant="full"</span>
            <TrustSection
              distribution={[{ stars: 5, count: 112 }, { stars: 4, count: 11 }, { stars: 3, count: 3 }, { stars: 2, count: 1 }, { stars: 1, count: 0 }]}
            />
            <span class="lbl">variant="band"</span>
            <TrustSection variant="band" />
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Vendre ici</span>
            <span class="spec-card__sub">SellHere — bande vert tendre et variante compacte · source datée obligatoire</span>
          </div>
          <div class="spec-card__stage">
            <span class="lbl">variant="band"</span>
            <SellHere
              eyebrow="Vous vendez à Gerpinnes"
              title="Votre maison vaut peut-être plus que vous ne le pensez"
              lede="Estimation gratuite et sans engagement, par un conseiller qui connaît votre rue."
              headline="34"
              headlineLabel="jours — délai médian avant compromis"
              rows={[{ label: "Prix médian maison", value: "345 000 €" }, { label: "Biens vendus en 2025", value: "41" }]}
              source="Données internes Avenir · au 31 août 2026"
            />
            <span class="lbl">variant="compact"</span>
            <SellHere
              variant="compact"
              eyebrow="Vous vendez"
              title="Estimez en 2 minutes"
              rows={[{ label: "délai médian", value: "34 j" }, { label: "prix médian", value: "345 k€" }]}
              fineprint="Réponse sous 24 h ouvrées"
              secondaryLabel=""
            />
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Maillage localité</span>
            <span class="spec-card__sub">LocalityLinks — « Élargir autour » et bloc groupé par intention (ancres descriptives)</span>
          </div>
          <div class="spec-card__stage">
            <span class="lbl">variant="widen" — sous les filtres</span>
            <LocalityLinks
              variant="widen"
              links={[{ text: "Maisons à vendre à Loverval", href: "#", count: 8 }, { text: "Maisons à vendre à Nalinnes", href: "#", count: 5 }, { text: "Maisons à vendre à Acoz", href: "#", count: 3 }]}
            />
            <span class="lbl">variant="mesh" — bloc groupé</span>
            <LocalityLinks
              title="Chercher ailleurs autour de Gerpinnes"
              groups={[
                { label: "Maisons à vendre", links: [{ text: "à Loverval", href: "#", count: 8 }, { text: "à Nalinnes", href: "#", count: 5 }, { text: "à Charleroi", href: "#", count: 21, current: true }] },
                { label: "Appartements à louer", links: [{ text: "à Charleroi", href: "#", count: 14 }, { text: "à Gilly", href: "#", count: 6 }] },
              ]}
            />
          </div>
        </article>

      </div>

      <!-- ======================= ÎLES REACT (client:visible) ======================= -->
      <h2 class="cat-group">Îles React — client:visible (budget JavaScript)</h2>
      <div class="catalog">

        <article class="spec-card">
          <div class="spec-card__head">
            <span class="spec-card__name">FAQ</span>
            <span class="spec-card__sub">Faq — accordéon ; réponses toujours dans le HTML (SEO)</span>
          </div>
          <div class="spec-card__stage">
            <Faq
              client:visible
              structuredData={false}
              items={[
                { q: "Quels sont les droits d'enregistrement en Wallonie ?", a: "Le taux ordinaire est de 12,5 %. Un taux réduit à 6 % s'applique à l'habitation propre et unique sous conditions." },
                { q: "Combien de temps faut-il pour vendre un bien ?", a: "Sur nos transactions 2025, le délai médian avant compromis est de 34 jours dans l'entité de Gerpinnes." },
                { q: "L'estimation est-elle payante ?", a: "Non. L'estimation est gratuite et sans engagement, réalisée par un conseiller de votre commune." },
              ]}
            />
          </div>
        </article>

        <article class="spec-card">
          <div class="spec-card__head">
            <span class="spec-card__name">Partage</span>
            <span class="spec-card__sub">ShareBar — presse-papier + état « ✓ Lien copié »</span>
          </div>
          <div class="spec-card__stage">
            <span class="lbl">variant="row"</span>
            <ShareBar client:visible url="https://avenir-immobilier.be/blog/prix-charleroi-2026" title="Prix de l'immobilier à Charleroi : la rentrée 2026" />
            <span class="lbl">variant="sticky"</span>
            <ShareBar client:visible variant="sticky" url="https://avenir-immobilier.be/blog/prix-charleroi-2026" title="Prix de l'immobilier à Charleroi : la rentrée 2026" networks={["linkedin", "facebook", "whatsapp", "copy"]} />
          </div>
        </article>

        <article class="spec-card">
          <div class="spec-card__head">
            <span class="spec-card__name">Menu déroulant</span>
            <span class="spec-card__sub">DropdownMenu — dernier recours ; préférer le &lt;select&gt; natif</span>
          </div>
          <div class="spec-card__stage">
            <DropdownMenu client:visible label="Trier par" options={["Prix croissant", "Prix décroissant", "Plus récents", "Surface"]} />
            <DropdownMenu client:visible block muted label="Nombre de chambres" options={["1 à 2", "3 à 4", "5 et plus"]} />
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Contact</span>
            <span class="spec-card__sub">ContactForm — tonalité claire et tonalité encre · consentement RGPD</span>
          </div>
          <div class="spec-card__stage stage--2col">
            <ContactForm client:visible />
            <ContactForm
              client:visible
              tone="ink"
              coordinates={[
                { label: "Téléphone", value: "+32 71 32 14 70", href: "tel:+3271321470" },
                { label: "E-mail", value: "bonjour@avenir-immobilier.be", href: "mailto:bonjour@avenir-immobilier.be" },
              ]}
            />
          </div>
        </article>

      </div>

      <!-- ============================ COULEURS ============================ -->
      <h2 class="cat-group">Couleurs — tokens du design system (rendus via @theme inline)</h2>
      <div class="catalog">

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Verts &amp; jaune de marque</span>
            <span class="spec-card__sub">Charte client : vert foncé primaire, vert clair accent, jaune signal</span>
          </div>
          <div class="spec-card__stage">
            <div class="cswgrid">
              <div class="csw cd" style="background:var(--green)"><span class="csw-name">--green</span><span class="csw-hex">#17413B · vert foncé</span></div>
              <div class="csw cd" style="background:var(--green-d)"><span class="csw-name">--green-d</span><span class="csw-hex">#0E2B27 · hover</span></div>
              <div class="csw cd" style="background:var(--green-l)"><span class="csw-name">--green-l</span><span class="csw-hex">#00A678 · vert clair</span></div>
              <div class="csw" style="background:var(--green-soft)"><span class="csw-name">--green-soft</span><span class="csw-hex">#D6F0E7</span></div>
              <div class="csw" style="background:var(--green-tint)"><span class="csw-name">--green-tint</span><span class="csw-hex">#EDF7F3</span></div>
              <div class="csw" style="background:var(--yellow)"><span class="csw-name">--yellow</span><span class="csw-hex">#EDE300 · jaune</span></div>
            </div>
            <span class="lbl">Chips en var(--token) — ce que rendent aussi les utilitaires bg-green/-l/-yellow via le pont @theme inline (jamais de valeur figée).</span>
          </div>
        </article>

        <article class="spec-card spec-card--wide">
          <div class="spec-card__head">
            <span class="spec-card__name">Encres</span>
