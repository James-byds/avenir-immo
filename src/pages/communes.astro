  /* à reprendre dans le DS — localites.html : taille du H1 et du corps « Namur » (styles inline de la maquette). */
  .cm-title { font-size: clamp(34px, 4.6vw, 62px); }
  .cm-namur { font-size: 15px; }
</style>
