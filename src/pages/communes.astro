---
/* Hub des localités — gabarit 04 (réf. docs/handoff/reference/localites.html).
   Journal : « Hub des localités + états de la liste ».

   6 sections, alternance stricte : bandeau encre (band) → tint marchés →
   blanc avis → tint carte → blanc index → tint vendeur. Le footer suit.

   Règles du gabarit : AUCUN compteur affiché (ancres descriptives seulement) ;
   jamais de lien vers une combinaison sans bien — chaque lien /biens?… et
   chaque lien de localité est GARDÉ au build (lienBiens / lienLocalite). */
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import PageHead from "../components/chrome/PageHead.astro";
import Breadcrumb from "../components/core/Breadcrumb.astro";
import Eyebrow from "../components/core/Eyebrow.astro";
import MarketCard from "../components/surfaces/MarketCard.astro";
import { jsonLd } from "../lib/seo";
import { formatPrix } from "../lib/format";
import { combinaisons, slugCombinaison, slugCommune } from "../lib/maillage";

/* ── Collections ── */
const communes = await getCollection("communes");
const biens = await getCollection("biens", ({ data }) => data.publie !== false);
const avis = await getCollection("avis");
type Bien = (typeof biens)[number];

/* ── Routes de localité réellement générées : combinaisons DÉCLARÉES par les
   communes ∩ combinaisons NON VIDES des biens (mêmes règles que getStaticPaths
   de [type]-a-[transaction]-[commune]) — les seules cibles de lien valides. ── */
const declarees = new Set(
  communes.flatMap((c) =>
    c.data.combinaisons.map(({ type, transaction }) =>
      slugCombinaison(type, transaction, slugCommune(c.data.nom)),
    ),
  ),
);
const routesLocalite = combinaisons(
  biens.map(({ data }) => ({ type: data.type, transaction: data.transaction, commune: data.commune })),
).filter((c) => declarees.has(c.slug));

/* Garde : un lien vers une page de localité doit viser une route générée. */
const lienLocalite = (text: string, slug: string) => {
  if (!routesLocalite.some((c) => c.slug === slug))
    throw new Error(`/communes : « ${text} » pointe vers /${slug}, route non générée.`);
  return { text, href: `/${slug}` };
};

/* Garde : un lien /biens?cat=…&loc=…&type=… doit avoir au moins un bien publié
   derrière (contrat d'URL de /biens). Mêmes conventions que /biens : « Charleroi
   centre » regroupé sous `charleroi`, la villa éclatée comme type de filtre. */
const locSlugDe = (commune: string) => {
  const s = slugCommune(commune);
  return s === "charleroi-centre" ? "charleroi" : s;
};
const catDe = (b: Bien) =>
  b.data.statut === "vendu" ? "vendu" : b.data.transaction === "location" ? "location" : "vente";
const typeSlugDe = (b: Bien) => (b.data.sousType === "villa" ? "villa" : b.data.type);
const lienBiens = (text: string, cat: string, loc?: string, type?: string) => {
  const ok = biens.some(
    (b) =>
      catDe(b) === cat &&
      (!loc || locSlugDe(b.data.commune) === loc) &&
      (!type || typeSlugDe(b) === type),
  );
  if (!ok)
    throw new Error(`/communes : « ${text} » (cat=${cat}, loc=${loc}, type=${type}) sans bien publié.`);
  const q = [`cat=${cat}`, loc && `loc=${loc}`, type && `type=${type}`].filter(Boolean).join("&");
  return { text, href: `/biens?${q}` };
};

/* ── Communes détaillées + conseillers référents (pages[].conseiller) ──
   Le Grand Charleroi n'a pas d'entrée communes/ (aucune combinaison déclarée,
   aucune route) : son conseiller vient de la maquette — Olivier Monier. */
const gerpinnes = communes.find((c) => c.data.nom === "Gerpinnes");
const liege = communes.find((c) => c.data.nom === "Liège");
if (!gerpinnes || !liege) throw new Error("/communes : entrées Gerpinnes et Liège requises.");

const conseillerCharleroi = await getEntry("equipe", "olivier-monier");
const conseillerGerpinnes = await getEntry(gerpinnes.data.pages[0].conseiller);
const conseillerLiege = await getEntry(liege.data.pages[0].conseiller);
if (!conseillerCharleroi || !conseillerGerpinnes || !conseillerLiege)
  throw new Error("/communes : conseiller référent introuvable dans equipe/.");

/* Même convention d'avatar que l'accueil (assets fournis par le client). */
const photoDe = (id: string) => `/assets/agent-${id.split("-")[0]}.png`;
const whoDe = (m: NonNullable<typeof conseillerCharleroi>) => ({
  nom: m.data.nom,
  role: "Votre conseiller ici",
  tel: m.data.telephone,
  href: `/equipe/${m.id}`,
  photo: photoDe(m.id),
});

/* ── Chiffres de marché : depuis communes.chiffres (source datée Zod). ── */
function figDe(commune: CollectionEntry<"communes">, label: string, court: string) {
  const c = commune.data.chiffres.find((x) => x.label === label);
  if (!c) throw new Error(`communes/${commune.id} : chiffre « ${label} » absent.`);
  const valeur =
    typeof c.valeur === "number" && c.unite === "€"
      ? formatPrix(c.valeur)
      : `${c.valeur} ${c.unite ?? ""}`.trimEnd();
  return { valeur, label: court, source: c.source.libelle };
}
const figGerpMedian = figDe(gerpinnes, "Prix médian d'une maison à Gerpinnes", "Maison · prix médian");
const figGerpEvo = figDe(gerpinnes, "Évolution des prix sur 12 mois", "Sur un an");
const figLiegeMedian = figDe(liege, "Prix médian d'une maison à Liège", "Maison · prix médian");
const figLiegeEvo = figDe(liege, "Évolution des prix sur 12 mois", "Sur un an");

/* Grand Charleroi : à sourcer — valeur maquette (23 sept. 2026). Prix médians
   repris de la référence localites.html (« Statbel, année 2025 ») : pas
   d'entrée communes/charleroi.md pour les porter avec un schéma sourcé. */
const figsCharleroi = [
  { valeur: formatPrix(155000), label: "Maison · prix médian 2025" },
  { valeur: formatPrix(125000), label: "Appartement · prix médian" },
];

/* Ligne de source de la section marchés : Gerpinnes & Liège viennent des
   collections ; le Grand Charleroi garde la source de la maquette, marquée. */
const sourceMarches = `Grand Charleroi : prix médians communaux, Statbel, année 2025 (à sourcer — valeur maquette, 23 sept. 2026) · Gerpinnes & Liège : ${figGerpMedian.source}.`;

/* ── Les trois marchés : copie de la référence, chiffres sourcés, liens gardés.
   Coordonnées : communes.coord quand déclaré, sinon valeurs de la maquette. ── */
const marches = [
  {
    id: "charleroi",
    nom: "Grand Charleroi",
    photoTag: "Charleroi — boulevard Tirou",
    titre: "Le marché que nous suivons depuis 1992",
    texte:
      "Du centre-ville aux communes de la première couronne. Appartements de standing en ville, maisons familiales à Montigny et Mont-sur-Marchienne.",
    figs: figsCharleroi,
    conseiller: whoDe(conseillerCharleroi),
    liens: [
      lienBiens("Appartements à vendre à Charleroi", "vente", "charleroi", "appartement"),
      lienBiens("Appartements à louer à Charleroi", "location", "charleroi", "appartement"),
      { text: "Faire estimer à Charleroi", href: "/estimation" },
    ],
    villages: "Charleroi · Montigny · Mont-sur-Marchienne · Marcinelle · Fleurus",
    pts: [
      ["Charleroi", 50.4114, 4.4446],
      ["Montigny-le-Tilleul", 50.3833, 4.3667],
      ["Mont-sur-Marchienne", 50.3928, 4.4064],
      ["Marcinelle", 50.3906, 4.4367],
      ["Fleurus", 50.4833, 4.55],
    ],
  },
  {
    id: "gerpinnes",
    nom: "Gerpinnes & Loverval",
    photoTag: "Gerpinnes — lisière de bois",
    titre: "La ceinture des villas et des grands jardins",
    texte:
      "Nalinnes, Gerpinnes, Loverval : des biens rares, souvent vendus avant leur mise en ligne. C'est ici que nos délais sont les plus courts.",
    figs: [figGerpMedian, figGerpEvo],
    conseiller: whoDe(conseillerGerpinnes),
    liens: [
      lienLocalite("Le marché de Gerpinnes", "maison-a-vendre-gerpinnes"),
      lienBiens("Villas à vendre à Gerpinnes", "vente", "gerpinnes", "villa"),
      lienBiens("Maisons à vendre à Loverval", "vente", "loverval", "maison"),
    ],
    villages: "Gerpinnes · Loverval · Nalinnes · Acoz",
    pts: [
      ["Gerpinnes", gerpinnes.data.coord?.lat ?? 50.3384, gerpinnes.data.coord?.lng ?? 4.5245],
      ["Loverval", 50.3743, 4.4548],
      ["Nalinnes", 50.3486, 4.4633],
      ["Acoz", 50.3618, 4.5354],
    ],
  },
  {
    id: "liege",
    nom: "Liège",
    photoTag: "Liège — quais de la Meuse",
    titre: "Notre marché le plus récent, ouvert en 2024",
    texte:
      "Deux conseillers y travaillent à temps plein. Le catalogue y est encore court : nous préférons peu de mandats bien suivis.",
    figs: [figLiegeMedian, figLiegeEvo],
    conseiller: whoDe(conseillerLiege),
    liens: [
      lienLocalite("Maisons à vendre à Liège", "maison-a-vendre-liege"),
      lienLocalite("Appartements à louer à Liège", "appartement-a-louer-liege"),
    ],
    villages: "Liège · Angleur · Chênée",
    pts: [
      ["Liège", liege.data.coord?.lat ?? 50.6326, liege.data.coord?.lng ?? 5.5797],
      ["Angleur", 50.6069, 5.5878],
      ["Chênée", 50.6169, 5.6178],
    ],
  },
];

/* ── Un avis par marché, choisi dans la collection par commune (les trois
   citations de la référence existent dans avis/) ; la ligne de contexte
   (« Vente d'un appartement · Bd Tirou, Charleroi ») vient du corps du .md. ── */
const parIdAvis = new Map(avis.map((a) => [a.id, a]));
const avisMarches = [
  { id: "j-hubert", marche: "Grand Charleroi", communes: ["Charleroi", "Charleroi centre"] },
  { id: "p-dessart", marche: "Gerpinnes & Loverval", communes: ["Gerpinnes", "Loverval", "Nalinnes", "Acoz", "Gougnies"] },
  { id: "m-lambin", marche: "Liège", communes: ["Liège"] },
].map(({ id, marche, communes: cs }) => {
  const a = parIdAvis.get(id);
  if (!a || !cs.includes(a.data.commune ?? ""))
    throw new Error(`/communes : avis « ${id} » absent ou hors du marché ${marche}.`);
  return { a, marche };
});
const initialesDe = (nom: string) => {
  const mots = nom.split(/\s+/).filter((m) => /^\p{L}/u.test(m));
  return ((mots[0]?.[0] ?? "") + (mots.length > 1 ? mots[mots.length - 1][0] : "")).toUpperCase();
};

/* Temps de route depuis Gerpinnes (communes.trajets) — la ligne .q-drive sous
   la liste des marchés appuie le « quinze minutes » du titre de section. */
const trajets = gerpinnes.data.trajets.slice(0, 3);

/* ── Index par intention (.lx) — chaque lien est gardé au build. ── */
const lxCols = [
  {
    label: "Acheter",
    liens: [
      lienBiens("Maisons à vendre à Mont-sur-Marchienne", "vente", "mont-sur-marchienne", "maison"),
      lienBiens("Appartements à vendre à Mont-sur-Marchienne", "vente", "mont-sur-marchienne", "appartement"),
      lienBiens("Maisons à vendre à Fleurus", "vente", "fleurus", "maison"),
      lienBiens("Maisons à vendre à Marcinelle", "vente", "marcinelle", "maison"),
      lienBiens("Maisons à vendre à Ransart", "vente", "ransart", "maison"),
      lienBiens("Villas à vendre à Nalinnes", "vente", "nalinnes", "villa"),
    ],
  },
  {
    label: "Louer",
    liens: [
      lienBiens("Appartements à louer à Charleroi", "location", "charleroi", "appartement"),
      lienBiens("Appartements à louer à Gilly", "location", "gilly", "appartement"),
      lienLocalite("Maisons à louer à Liège", "maison-a-louer-liege"),
    ],
  },
  {
    label: "Vendre & estimer",
    liens: [
      { text: "Estimation gratuite, toutes communes", href: "/estimation" },
      { text: "Notre méthode de vente", href: "/#vendre" },
      lienBiens("Nos ventes à Montigny-le-Tilleul", "vendu", "montigny-le-tilleul", "maison"),
      lienBiens("Toutes nos ventes conclues", "vendu"),
    ],
  },
];

/* ── Head : title/description/canonical de la référence + JSON-LD. ── */
const title = "Nos communes — où Avenir Immobilier vend et estime · Charleroi, Gerpinnes, Liège";
const description =
  "Les communes où nous travaillons vraiment : le Grand Charleroi depuis 1992, la ceinture de Gerpinnes et Loverval, et Liège depuis 2024. Un interlocuteur par commune, pas un standard.";
const canonical = new URL("/communes", Astro.site).href;

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Nos communes", item: canonical },
  ],
};

/* ItemList : les pages de localité réellement générées — mêmes données que
   les liens affichés (ancres descriptives de lib/maillage). */
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Les pages de localité d'Avenir Immobilier",
  numberOfItems: routesLocalite.length,
  itemListElement: routesLocalite.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.ancre,
    item: new URL(`/${c.slug}`, Astro.site).href,
  })),
};

/* Config de la carte, lue par le <script> de page (motif listingCfg du 05). */
const mapCfg = Object.fromEntries(marches.map((m) => [m.id, { pts: m.pts }]));

const delay = (i: number) => (i % 3 === 1 ? " d1" : i % 3 === 2 ? " d2" : "");
---

<PageLayout title={title} description={description} canonical={canonical} active="/communes">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd(breadcrumbLd)} />
    <script type="application/ld+json" is:inline set:html={jsonLd(itemListLd)} />
  </Fragment>

  <!-- ============ 1 · BANDEAU ENCRE (fil d'Ariane + H1 + chapô) ============ -->
  <PageHead variant="band" photoTag="Vue aérienne du Grand Charleroi — 1600 × 600">
    <Fragment slot="breadcrumb">
      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Nos communes" }]} />
    </Fragment>
    <div class="section-head mt-5">
      <Eyebrow>Là où nous travaillons vraiment</Eyebrow>
      <h1 class="cm-title mt-4 max-w-[22ch]">Trois marchés, un seul bureau.</h1>
      <p class="mt-4.5 max-w-[58ch]">Nous ne couvrons pas la Wallonie : nous couvrons les communes où nous connaissons les rues, les écoles et le prix réel au mètre carré. Le Grand Charleroi depuis 1992, la ceinture de Gerpinnes et Loverval, et Liège depuis 2024.</p>
    </div>
  </PageHead>

  <!-- ============ 2 · NOS TROIS MARCHÉS (vert tendre, cartes riches) ============ -->
  <section class="sec--tint">
    <div class="wrap">
      <div class="section-head reveal">
        <Eyebrow>Nos trois marchés</Eyebrow>
        <h2 class="max-w-[26ch]">Chacun a sa page, son conseiller, ses prix</h2>
      </div>

      <div class="prop-grid mt-11">
        {marches.map((m, i) => (
          <MarketCard
            class={`reveal${delay(i)}`}
            nom={m.nom}
            titre={m.titre}
            texte={m.texte}
            photoTag={m.photoTag}
            figs={m.figs}
            conseiller={m.conseiller}
            liens={m.liens}
          />
        ))}
      </div>

      <p class="cm-namur mt-7.5 text-ink-soft max-w-[60ch]"><strong class="text-ink">Namur</strong> — nous y intervenons sur mandat de prestige uniquement, sans page dédiée : <a href="/contact" class="text-green-d font-semibold">parlez-nous de votre bien</a>.</p>
      <p class="sell-src text-left">{sourceMarches}</p>
    </div>
  </section>

  <!-- ============ 3 · UN AVIS PAR MARCHÉ (blanc) ============ -->
  <section class="sec--white">
    <div class="wrap">
      <div class="section-head reveal">
        <Eyebrow>Ce qu'on nous en dit</Eyebrow>
        <h2 class="max-w-[26ch]">Un avis par marché, avec la commune</h2>
      </div>
      <div class="loc-avis mt-[clamp(26px,3.2vw,38px)]">
        {avisMarches.map(({ a, marche }, i) => (
          <article class={`t-card reveal${delay(i)}`}>
            <div class="t-headrow">
              <span class="t-cstars" aria-label={`${a.data.note} étoiles sur 5`}>{"★".repeat(a.data.note)}</span>
              <span class="t-chip">{marche}</span>
            </div>
            <p class="t-quote">{a.data.texte}</p>
            <div class="t-meta">
              <span class="t-ava" aria-hidden="true">{initialesDe(a.data.auteur)}</span>
              <span>
                <span class="t-name">{a.data.auteur}</span>
                <br />
                <span class="t-place">{(a.body ?? "").trim() || a.data.commune}</span>
              </span>
            </div>
          </article>
        ))}
      </div>
      <div class="loc-avis-foot">
        <a class="trust-google" href="/avis">
          <span class="tg-stars">★★★★★</span>
          <span class="tg-txt"><strong>4,8/5</strong> · 190 avis Google</span>
          <span class="tg-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 4 · LA CARTE DES TROIS MARCHÉS (vert tendre) ============ -->
  <section class="sec--tint">
    <div class="wrap">
      <div class="q-map-band">
        <div>
          <div class="section-head reveal text-left max-w-none">
            <Eyebrow>Où nous sommes, vraiment</Eyebrow>
            <h2 class="max-w-[20ch]">Trois marchés, quinze minutes de route entre les deux premiers</h2>
            <p class="mt-4 max-w-[46ch]">Choisissez un marché pour le situer. Nous n'intervenons pas au-delà de ces communes — sauf mandat de prestige.</p>
          </div>
          <ul class="mkt-rows" role="list">
            {marches.map((m, i) => (
              <li>
                <button type="button" class="mkt-row" data-m={m.id} aria-current={i === 0 ? "true" : "false"}>
                  <span class="mk-dot" aria-hidden="true"></span>
                  <span class="mk-txt"><span class="mk-n">{m.nom}</span><span class="mk-k">{m.villages}</span></span>
                </button>
              </li>
            ))}
          </ul>
          {trajets.length > 0 && (
            <p class="q-drive" aria-label="Temps de route depuis Gerpinnes">
              {trajets.map((t) => (
                <span><b>{`${t.minutes} min`}</b> Gerpinnes → {t.destination}</span>
              ))}
            </p>
          )}
        </div>
        <div class="q-map reveal">
          <div id="osm" aria-label="Carte des trois marchés d'Avenir Immobilier : Grand Charleroi, Gerpinnes et Loverval, Liège"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 5 · L'INDEX PAR INTENTION (blanc) ============ -->
  <section class="sec--white">
    <div class="wrap">
      <div class="section-head reveal">
        <Eyebrow>Le reste de nos communes</Eyebrow>
        <h2 class="max-w-[28ch]">Par ce que vous cherchez, pas par code postal</h2>
        <p class="mt-4 max-w-[56ch]">Les communes que les trois marchés ci-dessus ne détaillent pas. Chaque lien mène à des biens réellement disponibles aujourd'hui : si une combinaison n'apparaît pas, c'est que nous n'avons rien en portefeuille — et nous préférons vous le dire que vous faire cliquer.</p>
      </div>

      <div class="lx reveal mt-[clamp(26px,3.2vw,38px)]">
        {lxCols.map((col) => (
          <div class="lx-col">
            <span class="ll-lab">{col.label}</span>
            <ul class="lx-list">
              {col.liens.map((l) => (
                <li><a href={l.href}>{l.text}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 6 · VOUS VENDEZ ICI (vert tendre) ============
       Chips 900+ / 98 % / 38 j : chiffres de la maquette, déjà repris sur
       /estimation, couverts par la source datée affichée ci-dessous. -->
  <section class="sec--tint">
    <div class="wrap">
      <div class="sell-grid reveal">
        <div>
          <Eyebrow>Vous vendez dans une de ces communes ?</Eyebrow>
          <h2>La personne qui estime votre bien est celle qui le vendra</h2>
          <p class="sell-lede">Pas de standard, pas de transfert de dossier. Un rendez-vous sur place, une estimation écrite sous 48 h, et des honoraires dus uniquement si la vente se fait.</p>
          <div class="sell-chips">
            <span class="sell-chip"><b>900+</b> ventes depuis 1992</span>
            <span class="sell-chip"><b>98 %</b> vendus au prix estimé</span>
            <span class="sell-chip"><b>38 j</b> avant compromis</span>
          </div>
          <div class="sell-acts">
            <a href="/estimation" class="btn">Estimer mon bien <span class="arr">→</span></a>
            <a href="/contact" class="btn btn--ghost">Prendre rendez-vous</a>
          </div>
          <span class="sell-src">Chiffres de l'agence, arrêtés au 1<sup>er</sup> septembre 2026.</span>
        </div>
        <div class="ph sell-figure" role="img" aria-label="Photo à venir : une maison de la région mise en vente">
          <span class="ph-tag">Maison à Montigny-le-Tilleul — 900 × 1300 (portrait)</span>
        </div>
      </div>
    </div>
  </section>

  {/* Carte des trois marchés : Leaflet en script de page (vanilla) — l'île
     MapLeaflet ne porte qu'UN marqueur (carte agence) ; la logique reprend le
     script inline de la référence localites.html : marqueurs par marché,
     sélection au clic sur .mkt-row, recadrage sur le marché choisi. */}
  <script type="application/json" id="mapCfg" is:inline set:html={jsonLd(mapCfg)} />
  <script>
    import L from "leaflet";
    import type { LatLngBounds, Marker } from "leaflet";
    import "leaflet/dist/leaflet.css";

    type Pt = [string, number, number];
    const cfgEl = document.getElementById("mapCfg");
    const osm = document.getElementById("osm");
    if (cfgEl?.textContent && osm) {
      const markets = JSON.parse(cfgEl.textContent) as Record<string, { pts: Pt[] }>;

      const map = L.map(osm, { scrollWheelZoom: false, zoomControl: true });
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "© OpenStreetMap contributors",
        maxZoom: 19,
      }).addTo(map);

      /* Pastilles aux couleurs de la charte (vert profond sélectionné, vert
         clair sinon) — valeurs du script de la référence. */
      const icon = (on: boolean) => {
        const d = on ? 18 : 12;
        const ring = on
          ? "box-shadow:0 0 0 6px rgba(23,65,59,.2),0 0 0 13px rgba(23,65,59,.07)"
          : "box-shadow:0 0 0 4px rgba(0,166,120,.18)";
        const bg = on ? "var(--green)" : "var(--green-l)";
        return L.divIcon({
          className: "",
          html: `<span style="display:block;width:${d}px;height:${d}px;border-radius:50%;background:${bg};border:2px solid #fff;${ring}"></span>`,
          iconSize: [d, d],
          iconAnchor: [d / 2, d / 2],
        });
      };

      const groups: Record<string, { markers: Marker[]; bounds: LatLngBounds }> = {};
      const all: [number, number][] = [];
      for (const [k, m] of Object.entries(markets)) {
        const markers = m.pts.map((p) => {
          const mk = L.marker([p[1], p[2]], { icon: icon(false), title: p[0] }).addTo(map);
          mk.bindTooltip(p[0], { direction: "top", offset: [0, -10], className: "vil-lab" });
          all.push([p[1], p[2]]);
          return mk;
        });
        groups[k] = { markers, bounds: L.latLngBounds(m.pts.map((p) => [p[1], p[2]])) };
      }
      map.fitBounds(L.latLngBounds(all), { padding: [40, 40] });

      const rows = Array.from(document.querySelectorAll<HTMLButtonElement>(".mkt-row"));
      const select = (k: string) => {
        if (!groups[k]) return;
        rows.forEach((r) => r.setAttribute("aria-current", r.dataset.m === k ? "true" : "false"));
        for (const [o, g] of Object.entries(groups)) g.markers.forEach((mk) => mk.setIcon(icon(o === k)));
        map.fitBounds(groups[k].bounds, { padding: [60, 60], maxZoom: 12 });
      };
      rows.forEach((r) => r.addEventListener("click", () => r.dataset.m && select(r.dataset.m)));
    }
  </script>
</PageLayout>

