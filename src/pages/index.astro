---
/* Accueil — page témoin du handoff (gabarit 01, réf. docs/handoff/reference/index.html).
   13 sections ; les fonds sont portés par les classes DS/local (.services, .team,
   .blog, .process--light, .estimate, .trust, #quartiers) — jamais redoublés.
   Contenu : collections biens/articles/avis/equipe/communes ; copie de page
   (héros, preuves, méthode, FAQ) reprise mot pour mot de la référence. */
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Eyebrow from "../components/core/Eyebrow.astro";
import SectionHead from "../components/core/SectionHead.astro";
import PropertyCard from "../components/surfaces/PropertyCard.astro";
import TrustSection from "../components/surfaces/TrustSection.astro";
import FinalCta from "../components/surfaces/FinalCta.astro";
import Faq from "../components/islands/Faq.tsx";
import { faqPage, jsonLd } from "../lib/seo";
import { formatDate, formatPrix, formatSurface } from "../lib/format";
import { slugCombinaison, slugCommune } from "../lib/maillage";
import type { Transaction, TypeBien } from "../lib/maillage";

/* ── Biens : sélection du moment (ordre de la référence, vedette en tête) ── */
const biens = await getCollection("biens", ({ data }) => data.publie !== false);
const parId = new Map(biens.map((b) => [b.id, b]));
const SELECTION = [
  "villa-architecte-gerpinnes",
  "penthouse-mont-sur-marchienne",
  "maison-de-maitre-loverval",
  "loft-angle-charleroi",
  "maison-familiale-montigny",
  "propriete-equestre-nalinnes",
  "bel-etage-ransart",
  "appartement-neuf-gilly",
  "fermette-nalinnes",
];
const selection = SELECTION.map((id) => parId.get(id)).filter(
  (b): b is NonNullable<typeof b> => Boolean(b),
);

const TYPE_SINGULIER: Record<string, string> = {
  maison: "Maison",
  appartement: "Appartement",
  terrain: "Terrain",
  commerce: "Commerce",
  immeuble: "Immeuble",
};
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const tagDe = (b: (typeof selection)[number]) =>
  `${b.data.sousType ? cap(b.data.sousType) : TYPE_SINGULIER[b.data.type]} — ${b.data.commune}`;
const badgeDe = (b: (typeof selection)[number]) =>
  b.data.statut === "nouveau"
    ? { label: "Nouveau", variant: "new" as const }
    : b.data.statut === "sous-offre"
      ? { label: "Sous offre", variant: undefined }
      : b.data.statut === "vendu"
        ? { label: "Vendu", variant: "sold" as const }
        : undefined;
const specsDe = (b: (typeof selection)[number]) =>
  [
    b.data.chambres != null && `${b.data.chambres} ch.`,
    b.data.sdb != null && `${b.data.sdb} sdb`,
    b.data.surface != null && formatSurface(b.data.surface),
  ].filter((s): s is string => Boolean(s));
/* Catégories du filtre (#filters de ds-script.js) — posées en data-cat par le
   script correctif ci-dessous, PropertyCard n'acceptant pas d'attribut libre. */
const cats = selection.map((b) =>
  b.data.statut === "vendu" ? "vendu" : b.data.transaction === "location" ? "location" : "vente",
);

/* ── Équipe : carousel (ordre éditorial de la collection) ── */
const equipe = (await getCollection("equipe")).sort((a, b) => a.data.ordre - b.data.ordre);
const photoDe = (id: string) => `/assets/agent-${id.split("-")[0]}.png`;

/* ── Avis : les trois de la référence, texte et signature depuis la collection ── */
const avis = await getCollection("avis");
const parIdAvis = new Map(avis.map((a) => [a.id, a]));
const reviews = ["famille-lemaire", "toussaint", "sebastien-l"]
  .map((id) => parIdAvis.get(id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .map((a) => ({
    quote: a.data.texte,
    name: a.data.auteur,
    place: (a.body ?? "").trim() || a.data.commune || "",
    stars: a.data.note,
    /* photos (nombre) : 2 vignettes max en bandeau .t-imgs, le surplus en
       pastille « +n » — comme la référence (famille-lemaire n'en a pas). */
    photos: a.data.photos
      ? Array.from({ length: Math.min(a.data.photos, 2) }, (_, i) => `Photo ${i + 1}`)
      : undefined,
    morePhotos: a.data.photos && a.data.photos > 2 ? a.data.photos - 2 : undefined,
  }));

/* ── Blog : les trois articles de la référence ── */
const articles = await getCollection("articles", ({ data }) => data.publie !== false);
const parIdArticle = new Map(articles.map((a) => [a.id, a]));
const posts = ["home-staging-7-gestes", "prestige-charleroi-prix-2026", "off-market-mode-emploi"]
  .map((id) => parIdArticle.get(id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

/* ── Quartiers : uniquement les combinaisons de localité réellement générées
   (communes.combinaisons ∩ biens) — jamais de lien vers une page vide. ── */
const communes = await getCollection("communes");
const TYPE_PLURIEL: Record<string, string> = {
  maison: "Maisons",
  appartement: "Appartements",
  terrain: "Terrains",
  commerce: "Commerces",
  immeuble: "Immeubles",
};
const hoods = communes.flatMap((c) =>
  (c.data.combinaisons as { type: TypeBien; transaction: Transaction }[])
    .map(({ type, transaction }) => {
      /* Compte = périmètre RÉEL de la page cible : une copie de localité en
         listing:"transaction" liste tout le marché de la transaction (« 18
         biens ») — le compte du seul type la contredirait. Gabarit quartier
         (06) : la page cible liste TOUTE l'entité (villages inclus) — le
         compte suit, sinon la carte contredirait son « Voir les N biens ». */
      const cible = c.data.pages.find((p) => p.type === type && p.transaction === transaction);
      const quartier = c.data.gabarit === "quartier" && c.data.villages.length > 0;
      const noms = new Set([c.data.nom, ...(quartier ? c.data.villages.map((v) => v.nom) : [])]);
      const count = biens.filter(
        (b) =>
          noms.has(b.data.commune) &&
          b.data.transaction === transaction &&
          (quartier || cible?.listing === "transaction" || b.data.type === type),
      ).length;
      return {
        commune: c.data.nom,
        href: `/${slugCombinaison(type, transaction, slugCommune(c.data.nom))}`,
        label: `${TYPE_PLURIEL[type]} ${transaction === "location" ? "à louer" : "à vendre"}`,
        count,
      };
    })
    .filter((h) => h.count > 0),
);

/* ── FAQ : copie de la référence (mot pour mot) — le JSON-LD FAQPage reprend
   EXACTEMENT ces chaînes ; l'île Faq reçoit structuredData={false}. ── */
const faqItems = [
  {
    q: "L'estimation est-elle vraiment gratuite ?",
    a: "Oui, totalement gratuite et sans engagement. Vous recevez une première fourchette en ligne, puis un conseiller affine la valeur lors d'une visite sur place. Vous restez libre à chaque étape.",
  },
  {
    q: "En combien de temps vendez-vous un bien ?",
    a: "Le délai moyen constaté chez Avenir Immobilier est de 38 jours avant compromis, contre près de 90 jours sur le marché carolorégien — grâce à une mise en valeur soignée et à un réseau d'acquéreurs qualifiés.",
  },
  {
    q: "Quels sont vos honoraires ?",
    a: "Nos honoraires sont transparents et uniquement dus en cas de vente effective. Ils sont fixés lors du mandat, selon le bien et les prestations retenues (photographie, vidéo, home-staging…).",
  },
  {
    q: "Travaillez-vous en off-market ?",
    a: "Oui. Pour les vendeurs qui souhaitent la discrétion, nous présentons d'abord le bien à notre fichier d'acquéreurs qualifiés avant toute diffusion publique.",
  },
  {
    q: "Dans quels quartiers intervenez-vous ?",
    a: "À Charleroi : Loverval, Mont-sur-Marchienne, Montigny-le-Tilleul et le centre. En périphérie sud : Gerpinnes, Marcinelle et Nalinnes. Un doute sur votre commune ? Écrivez-nous.",
  },
];

/* ── JSON-LD — mêmes données que le HTML affiché (chrome : TopBar/SiteHeader).
   4,8/190 = chiffre externe Google, repris tel quel (cf. section avis). ── */
const GOOGLE_URL = "https://www.google.com/maps/search/Avenir+Immobilier+Charleroi";
const agentLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: "Avenir Immobilier",
  description:
    "Agence immobilière de prestige spécialisée dans la vente, l'achat et l'estimation de biens d'exception à Charleroi et en Hainaut.",
  url: Astro.site?.href ?? "https://www.lavenir-immobilier.be/",
  telephone: "+32 71 32 14 70",
  email: "info@avenir-immobilier.be",
  priceRange: "€€€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Boulevard Tirou 102",
    addressLocality: "Charleroi",
    postalCode: "6000",
    addressCountry: "BE",
  },
  areaServed: [
    "Loverval",
    "Mont-sur-Marchienne",
    "Montigny-le-Tilleul",
    "Charleroi",
    "Gerpinnes",
    "Marcinelle",
    "Nalinnes",
    "Liège",
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.8", reviewCount: "190" },
  openingHours: "Mo-Fr 09:00-18:30 Sa 10:00-16:00",
  sameAs: [GOOGLE_URL],
};
const faqLd = faqPage(faqItems.map(({ q, a }) => ({ question: q, reponse: a })));

const SOURCE_MAQUETTE = "À sourcer — valeurs maquette · 23 septembre 2026";
---

<PageLayout
  title="Avenir Immobilier · Agence immobilière de prestige à Charleroi — Vente & estimation"
  description="Avenir Immobilier accompagne la vente, l'achat et l'estimation de biens immobiliers d'exception à Charleroi : Loverval, Mont-sur-Marchienne, Montigny, Gerpinnes. Estimation gratuite en 2 minutes, un conseiller dédié, 98 % des biens vendus au prix estimé."
  solid={false}
  organizationLd={false}
>
  {/* JSON-LD de page (RealEstateAgent complet + FAQPage) dans le head, via le
     slot relayé par PageLayout ; organizationLd={false} coupe le bloc minimal
     du BaseLayout pour n'avoir qu'un seul RealEstateAgent. */}
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd(agentLd)} />
    <script type="application/ld+json" is:inline set:html={jsonLd(faqLd)} />
  </Fragment>

  <!-- ===================== 1 · HÉROS ===================== -->
  <section class="hero hero--media" id="accueil">
    <div class="hero-bg">
      <!-- Pour une vidéo de fond, remplacer .hero-bg-media par :
           <video class="hero-bg-media" autoplay muted loop playsinline poster="hero-poster.jpg">
             <source src="hero.mp4" type="video/mp4" />
           </video> -->
      <div class="hero-bg-media" role="img" aria-label="Vidéo ou image d'arrière-plan à intégrer"></div>
      <div class="hero-overlay"></div>
      <span class="hero-bg-note"><span class="play">▶</span> Vidéo / image plein écran — façade · vue drone · art de vivre</span>
    </div>
    <div class="wrap hero-inner">
      <Eyebrow>Agence de prestige à Charleroi · Depuis 1992</Eyebrow>
      <h1>L'immobilier de prestige,<br /><em>en plus simple</em>.</h1>
      <p class="lede">Depuis plus de 30 ans, Avenir Immobilier accompagne la vente, l'achat et l'estimation de biens d'exception à Charleroi et dans sa région — un seul interlocuteur, du premier rendez-vous à la signature.</p>
      <div class="hero-search" aria-label="Estimer, acheter ou louer un bien">
        <div class="hs-stack">
          <div class="hs-tabs" role="tablist">
            <button class="hs-tab on" type="button" data-mode="estimer" role="tab" aria-selected="true">Estimer<span class="hs-badge">Gratuit</span></button>
            <button class="hs-tab" type="button" data-mode="acheter" role="tab" aria-selected="false">Acheter</button>
            <button class="hs-tab" type="button" data-mode="louer" role="tab" aria-selected="false">Louer</button>
          </div>
          <form class="hs-bar" id="heroSearch">
            <div class="hs-row" id="hsEstimerRow">
              <label class="hs-field">
                <span class="hs-flabel">Localité du bien</span>
                <input id="hsEstLoc" placeholder="Où se trouve le bien ?" />
              </label>
              <button type="submit" class="hs-go" data-go="estimation">Estimer <span class="arr">→</span></button>
            </div>
            <div class="hs-row" id="hsSearchRow" hidden>
              <label class="hs-field">
                <span class="hs-flabel">Localité</span>
                <input id="hsLoc" placeholder="Où souhaitez-vous acheter ?" />
              </label>
              <div class="hs-field hs-field--dd" data-name="type">
                <span class="hs-flabel">Type de bien</span>
                <button type="button" class="hs-dd-btn" aria-haspopup="listbox" aria-expanded="false"><span class="hs-dd-val is-placeholder">Quel type de bien ?</span></button>
                <ul class="hs-dd-menu" role="listbox" aria-label="Type de bien">
                  <li class="hs-dd-opt" role="option" data-v="Maison">Maison</li>
                  <li class="hs-dd-opt" role="option" data-v="Appartement">Appartement</li>
                  <li class="hs-dd-opt" role="option" data-v="Villa">Villa</li>
                  <li class="hs-dd-opt" role="option" data-v="Terrain à bâtir">Terrain à bâtir</li>
                  <li class="hs-dd-opt" role="option" data-v="Immeuble">Immeuble</li>
                </ul>
              </div>
              <div class="hs-field hs-field--dd" data-name="budget">
                <span class="hs-flabel">Budget</span>
                <button type="button" class="hs-dd-btn" aria-haspopup="listbox" aria-expanded="false"><span class="hs-dd-val is-placeholder">Quel budget ?</span></button>
                <ul class="hs-dd-menu" role="listbox" aria-label="Budget">
                  <li class="hs-dd-opt" role="option" data-v="≤ 500 000 €">≤ 500 000 €</li>
                  <li class="hs-dd-opt" role="option" data-v="500 000 – 1 M€">500 000 – 1 M€</li>
                  <li class="hs-dd-opt" role="option" data-v="1 – 2 M€">1 – 2 M€</li>
                  <li class="hs-dd-opt" role="option" data-v="2 M€ et +">2 M€ et +</li>
                </ul>
              </div>
              <button type="submit" class="hs-go" data-go="biens"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.2-4.2"></path></svg> Chercher</button>
            </div>
          </form>
        </div>
        <a href="#estimation" class="hs-locate" id="hsLocate"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-5.2-6-10a6 6 0 1112 0c0 4.8-6 10-6 10z"></path><circle cx="12" cy="11" r="2"></circle></svg> Utiliser ma localisation actuelle</a>
      </div>
      <div class="hero-trust">
        <span class="stars">★★★★★</span>
        <span><strong>4,8/5</strong> — 190 avis vérifiés de vendeurs &amp; acquéreurs accompagnés</span>
      </div>
    </div>
  </section>

  <!-- ===================== 2 · PREUVES (pictogrammes) ===================== -->
  <section class="proofs sec--white" id="preuves">
    <div class="wrap">
      <div class="reveal">
        <SectionHead eyebrow="Nos résultats" title="Quatre raisons de nous confier votre bien" />
      </div>
      <div class="proof-grid">
        <div class="proof reveal">
          <img class="proof-ic proof-ic--wide" src="/assets/picto-25-ans.png" alt="25 ans d'expérience" width="960" height="745" loading="lazy" />
          <h3>25 ans d'expérience</h3>
          <p class="proof-fig">Depuis 1992 à Charleroi</p>
          <p>Depuis 1992, nous accompagnons vendeurs et acquéreurs à Charleroi et dans sa région. Une connaissance fine du marché local qui permet d'anticiper, de conseiller juste et de mettre rapidement les bons acquéreurs face aux bons biens.</p>
        </div>
        <div class="proof reveal d1">
          <img class="proof-ic" src="/assets/picto-89-rapidite.png" alt="89 % de nos biens vendus en moins d'un mois" width="819" height="1400" loading="lazy" />
          <h3>Vendre plus rapidement</h3>
          <p class="proof-fig">89 % vendus en moins d'un mois</p>
          <p>Un fichier d'acquéreurs qualifiés et une stratégie de commercialisation préparée en amont donnent au bien sa visibilité maximale dès la mise en vente — sans brader le délai contre la qualité de la transaction.</p>
        </div>
        <div class="proof reveal d2">
          <img class="proof-ic" src="/assets/picto-87-valorisation.png" alt="87 % de nos biens vendus plus haut que les prix affichés" width="966" height="1428" loading="lazy" />
          <h3>Obtenir la meilleure valorisation</h3>
          <p class="proof-fig">87 % vendus au-dessus du prix affiché</p>
          <p>Vendre ne consiste pas à trouver un acquéreur, mais à vendre dans les meilleures conditions et au meilleur prix. Notre rôle est de défendre vos intérêts jusqu'au dernier euro de la négociation.</p>
        </div>
        <div class="proof reveal d3">
          <img class="proof-ic" src="/assets/picto-0-litige.png" alt="Zéro litige judiciaire" width="781" height="1228" loading="lazy" />
          <h3>Vendre sans mauvaise surprise</h3>
          <p class="proof-fig">0 litige judiciaire</p>
          <p>Dossiers d'acquéreurs vérifiés, documents analysés en amont, offres sécurisées : de l'estimation à l'acte, nous prenons en charge l'ensemble des démarches et assurons un suivi complet du dossier.</p>
        </div>
      </div>
      <p class="sell-src reveal text-center">{SOURCE_MAQUETTE}</p>
    </div>
  </section>

  <!-- ===================== 3 · SERVICES ===================== -->
  <section class="services" id="vendre">
    <div class="wrap">
      <div class="reveal">
        <SectionHead eyebrow="Un accompagnement sur-mesure" title="Quatre métiers, une exigence">
          Que vous vendiez l'appartement d'une vie ou cherchiez la maison des trente prochaines années, vous parlez à une équipe — jamais à un standard.
        </SectionHead>
      </div>
      <div class="serv-grid">
        <div class="serv reveal"><div class="s-no">01</div><h3>Vendre</h3><p>Estimation juste, mise en scène, photographie professionnelle et diffusion ciblée auprès d'acquéreurs qualifiés.</p><a href="#estimation" class="link-arrow">Vendre avec Avenir →</a></div>
        <div class="serv reveal d1"><div class="s-no">02</div><h3>Acheter</h3><p>Un chasseur dédié, l'accès aux biens off-market et une négociation menée dans votre seul intérêt.</p><a href="#contact" class="link-arrow">Trouver mon bien →</a></div>
        <div class="serv reveal d2"><div class="s-no">03</div><h3>Estimer</h3><p>Une valeur de marché fiable en deux minutes en ligne, affinée par la visite d'un expert local.</p><a href="#estimation" class="link-arrow">Estimer gratuitement →</a></div>
        <div class="serv reveal d3"><div class="s-no">04</div><h3>Gérer</h3><p>Gestion locative haut de gamme : sélection des locataires, suivi technique et reporting clair.</p><a href="#contact" class="link-arrow">Confier mon bien →</a></div>
      </div>
    </div>
  </section>

  <!-- ===================== 4 · BIENS ===================== -->
  <section class="sec--white" id="biens">
    <div class="wrap">
      <div class="props-head reveal">
        <SectionHead eyebrow="Sélection du moment" title="Nos biens d'exception" />
        <div class="props-tools">
          <div class="filters" id="filters" role="group" aria-label="Filtrer les biens">
            <button class="on" data-f="all">Tous</button>
            <button data-f="vente">À vendre</button>
            <button data-f="location">À louer</button>
            <button data-f="vendu">Vendu</button>
          </div>
          <span class="props-page" id="propPage" aria-live="polite">1 / 2</span>
        </div>
      </div>

      <form class="hero-search hero-search--inline reveal" id="propSearch" aria-label="Rechercher un bien à acheter ou à louer">
        <div class="hs-stack">
          <div class="hs-tabs" role="tablist" aria-label="Acheter ou louer">
            <button class="hs-tab on" type="button" data-pmode="acheter" role="tab" aria-selected="true">Acheter</button>
            <button class="hs-tab" type="button" data-pmode="louer" role="tab" aria-selected="false">Louer</button>
          </div>
          <div class="hs-bar">
            <div class="hs-row">
              <label class="hs-field">
                <span class="hs-flabel">Localité</span>
                <input id="psLoc" placeholder="Où souhaitez-vous acheter ?" />
              </label>
              <div class="hs-field hs-field--dd" data-name="type">
                <span class="hs-flabel">Type de bien</span>
                <button type="button" class="hs-dd-btn" aria-haspopup="listbox" aria-expanded="false"><span class="hs-dd-val is-placeholder">Quel type de bien ?</span></button>
                <ul class="hs-dd-menu" role="listbox" aria-label="Type de bien">
                  <li class="hs-dd-opt" role="option" data-v="Maison">Maison</li>
                  <li class="hs-dd-opt" role="option" data-v="Appartement">Appartement</li>
                  <li class="hs-dd-opt" role="option" data-v="Villa">Villa</li>
                  <li class="hs-dd-opt" role="option" data-v="Terrain à bâtir">Terrain à bâtir</li>
                  <li class="hs-dd-opt" role="option" data-v="Immeuble">Immeuble</li>
                </ul>
              </div>
              <div class="hs-field hs-field--dd" data-name="budget">
                <span class="hs-flabel" id="psBudgetLabel">Budget</span>
                <button type="button" class="hs-dd-btn" aria-haspopup="listbox" aria-expanded="false"><span class="hs-dd-val is-placeholder">Quel budget ?</span></button>
                <ul class="hs-dd-menu" role="listbox" aria-label="Budget">
                  <li class="hs-dd-opt" role="option" data-v="≤ 500 000 €">≤ 500 000 €</li>
                  <li class="hs-dd-opt" role="option" data-v="500 000 – 1 M€">500 000 – 1 M€</li>
                  <li class="hs-dd-opt" role="option" data-v="1 – 2 M€">1 – 2 M€</li>
                  <li class="hs-dd-opt" role="option" data-v="2 M€ et +">2 M€ et +</li>
                </ul>
              </div>
              <button type="submit" class="hs-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.2-4.2"></path></svg> Chercher</button>
            </div>
          </div>
        </div>
      </form>

      <div class="prop-stage">
        <button class="team-arrow prop-nav prop-nav--prev" id="propPrev" type="button" aria-label="Biens précédents">←</button>
        <button class="team-arrow prop-nav prop-nav--next" id="propNext" type="button" aria-label="Biens suivants">→</button>
        <div class="prop-grid" id="propGrid">
          {selection.map((b, i) => (
            <PropertyCard
              variant={i === 0 ? "overlay" : undefined}
              price={formatPrix(b.data.prix)}
              suffix={b.data.transaction === "location" ? "/ mois" : undefined}
              location={b.data.commune}
              title={b.data.titre}
