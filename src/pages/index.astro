  {/* À REPRENDRE DANS LE DS — script.js code en dur `window.location.href =
      "biens.html"` au submit de #propSearch (la saisie est jetée) et se
      contente de défiler pour #heroSearch en mode Acheter/Louer. Interception
      en PHASE DE CAPTURE (ce script précède /ds-script.js en fin de body) pour
      transmettre la saisie vers /biens selon le contrat d'URL du README :
      ?cat=vente|location&loc=<slug>&type=<slug> (+ budget, conservé).
      Le mode Estimer du héros garde le comportement DS (défilement vers
      #estimation, le formulaire trois étapes prend le relais). */}
  <script is:inline>
    (function () {
      var slug = function (s) {
        return String(s || "")
          .normalize("NFD")
          .replace(/[̀-ͯ]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "");
      };
      var TYPES = { maison: "maison", appartement: "appartement", villa: "villa", "terrain-a-batir": "terrain", immeuble: "immeuble" };
      document.addEventListener(
        "submit",
        function (e) {
          var form = e.target;
          if (!form || (form.id !== "propSearch" && form.id !== "heroSearch")) return;
          var scope = form.id === "heroSearch" ? form.closest(".hero-search") : form;
          var tab = scope.querySelector(".hs-tab.on");
          var mode = tab ? tab.dataset.pmode || tab.dataset.mode : "acheter";
          if (mode === "estimer") return; /* comportement DS conservé */
          e.preventDefault();
          e.stopPropagation();
          var p = new URLSearchParams();
          p.set("cat", mode === "louer" ? "location" : "vente");
          var locInput = form.querySelector(form.id === "heroSearch" ? "#hsLoc" : "#psLoc");
          if (locInput && locInput.value.trim()) p.set("loc", slug(locInput.value));
          var typeDd = form.querySelector('.hs-field--dd[data-name="type"]');
          if (typeDd && typeDd.dataset.value) {
            var t = slug(typeDd.dataset.value);
            p.set("type", TYPES[t] || t);
          }
          var budgetDd = form.querySelector('.hs-field--dd[data-name="budget"]');
          if (budgetDd && budgetDd.dataset.value) p.set("budget", budgetDd.dataset.value);
          window.location.assign("/biens?" + p.toString());
        },
        true
      );
    })();
  </script>
