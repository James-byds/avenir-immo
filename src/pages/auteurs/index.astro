---
/* Hub des rédacteurs — gabarit 13 (réf. docs/handoff/reference/auteurs.html).

   page-head clair (.au-hero : H1 + chiffres CALCULÉS) → « Quatre conseillers,
   une notaire invitée » (blanc, .writers de WriterCard photo) → « À lire cette
   semaine » (.blog vert tendre, 3 ArticleCard post les plus récents) →
   charte éditoriale (blanc, EditorialCharter) → CTA final aplat vert profond.
   Alternance : blanc (page-head à padding-bottom 0, prolongé par la section
   blanche, comme la référence) → tendre → blanc → vert profond.

   Aucun chiffre de la maquette n'est recopié : rédacteurs, articles publiés
   et « depuis » viennent des collections (règle « pas de chiffre non
   sourcé », arbitrage 3). Aucune PropertyCard : les rédacteurs restent
   distincts des agents. */
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import PageHead from "../../components/chrome/PageHead.astro";
import Breadcrumb from "../../components/core/Breadcrumb.astro";
import Eyebrow from "../../components/core/Eyebrow.astro";
import LinkArrow from "../../components/core/LinkArrow.astro";
import SectionHead from "../../components/core/SectionHead.astro";
import ArticleCard from "../../components/surfaces/ArticleCard.astro";
import WriterCard from "../../components/surfaces/WriterCard.astro";
import EditorialCharter from "../../components/surfaces/EditorialCharter.astro";
import FinalCta from "../../components/surfaces/FinalCta.astro";
import { jsonLd } from "../../lib/seo";

/* ── Rédacteurs (ordre de la référence : Camille, Julien, Sophie, Marc, Anne) ── */
const auteurs = (await getCollection("auteurs")).sort((a, b) => a.data.ordre - b.data.ordre);
const auteurParId = new Map(auteurs.map((a) => [a.id, a]));

/* ── Articles publiés, du plus récent au plus ancien ── */
const articles = (await getCollection("articles", ({ data }) => data.publie !== false)).sort(
  (a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime(),
);
const countDe = (id: string) => articles.filter((a) => a.data.auteur.id === id).length;
const recents = articles.slice(0, 3);

/* ── Chiffres du héros — calculés (n rédacteurs · n articles · depuis) ── */
const annees = auteurs.map((a) => a.data.depuis).filter((d): d is number => typeof d === "number");
const depuis = annees.length > 0 ? Math.min(...annees) : undefined;
const pl = (n: number, s: string) => (n > 1 ? s : "");
const stats = [
  { value: String(auteurs.length), label: `rédacteur${pl(auteurs.length, "s")}` },
  {
    value: String(articles.length),
    label: `article${pl(articles.length, "s")} publié${pl(articles.length, "s")}`,
  },
  ...(depuis ? [{ value: String(depuis), label: "depuis" }] : []),
];

const delay = (i: number) => (i % 3 === 1 ? " d1" : i % 3 === 2 ? " d2" : "");

/* ── Head (title / description de la référence) ── */
const title = "Nos rédacteurs — le journal d'Avenir Immobilier";
const description =
  "Les quatre conseillers et l'invitée qui signent les analyses de marché, guides vendeurs et conseils d'estimation du journal Avenir Immobilier, à Charleroi.";
const canonical = new URL("/auteurs", Astro.site).href;
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", Astro.site).href },
    { "@type": "ListItem", position: 3, name: "Nos rédacteurs", item: canonical },
  ],
};
---

<PageLayout title={title} description={description} canonical={canonical} active="/blog">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={jsonLd(breadcrumbLd)} />
  </Fragment>

  {/* ── 1 · EN-TÊTE — page-head clair (padding-bottom 0 : c'est le défaut DS,
       le style en ligne de la référence est sans effet) ── */}
  <PageHead>
    <Breadcrumb
      slot="breadcrumb"
      items={[{ label: "Accueil", href: "/" }, { label: "Blog", href: "/blog" }, { label: "Nos rédacteurs" }]}
    />
    <div class="au-hero">
      <div>
        <Eyebrow>Le journal</Eyebrow>
        <h1>Chaque article est signé, <em>par quelqu'un</em>.</h1>
        <p class="au-lede">
          Nos analyses de marché et nos guides sont écrits par les conseillers qui font les visites, les
          estimations et les compromis. Pas de rédaction externe, pas de contenu de complaisance.
        </p>
      </div>
      <div class="au-stats">
        {
          stats.map((s) => (
            <div class="st">
              <div class="sv">{s.value}</div>
              <div class="sl">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </PageHead>

  {/* ── 2 · QUI ÉCRIT — blanc, cinq cartes rédacteur (un seul lien par carte) ── */}
  <section class="sec--white">
    <div class="wrap">
      <div class="props-head reveal">
        <SectionHead eyebrow="Qui écrit" title="Quatre conseillers, une notaire invitée" />
        <LinkArrow href="/blog">Tous les articles</LinkArrow>
      </div>
      <div class="writers">
        {auteurs.map((a) => <WriterCard auteur={a} count={countDe(a.id)} class="reveal" />)}
      </div>
    </div>
  </section>

  {/* ── 3 · À LIRE CETTE SEMAINE — .blog vert tendre, 3 derniers articles ── */}
  <section class="blog sec--tint">
    <div class="wrap">
      <div class="props-head reveal">
        <SectionHead eyebrow="Derniers articles signés" title="À lire cette semaine" />
        <LinkArrow href="/blog">Voir tout le journal</LinkArrow>
      </div>
      <div class="blog-grid">
        {
          recents.map((a, i) => (
            <ArticleCard
              article={a}
              auteur={auteurParId.get(a.data.auteur.id)}
              variant="post"
              class={`reveal${delay(i)}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ── 4 · CHARTE — blanc ── */}
  <section class="sec--white">
    <div class="wrap">
      <EditorialCharter />
    </div>
  </section>

  {/* ── 5 · CTA FINAL — aplat vert profond (.finalcta--deep, local.css) ;
       .on-dark sur les actions pour le .btn--ghost (vigilance 11) ── */}
  <FinalCta tone="deep">
    <span class="eyebrow center reveal">Un sujet à nous proposer ?</span>
    <h2 class="reveal d1">Une question revient souvent ? <em>Écrivons-la</em>.</h2>
    <p class="reveal d2">
      Dites-nous ce que vous aimeriez comprendre — nos rédacteurs répondent sous 24 h, et parfois en article.
    </p>
    <div class="fc-actions on-dark reveal d2">
      <a href="/contact?sujet=article" class="btn">Proposer un sujet <span class="arr">→</span></a>
      <a href="/estimation" class="btn btn--ghost">Estimer mon bien</a>
    </div>
  </FinalCta>
</PageLayout>

<style>
  /* ── à reprendre dans le DS — gabarit 13 : <style> de page de auteurs.html
     (« Spécifique hub auteurs »), valeurs inchangées. ── */
  .au-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr); gap: clamp(28px, 4.5vw, 64px); align-items: end; margin-top: clamp(24px, 3vw, 34px); }
  .au-stats { display: flex; gap: clamp(22px, 3.5vw, 44px); flex-wrap: wrap; padding-bottom: 6px; }
  .au-stats .st .sv { font-family: var(--serif); font-weight: 600; font-size: clamp(28px, 3vw, 38px); color: var(--green); letter-spacing: -0.02em; }
  .au-stats .st .sl { font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-mute); margin-top: 5px; }
  /* margin-top ici et non en mt-* Tailwind : le reset `* { margin: 0 }` de
     site.css est hors couche et prime sur @layer utilities (recette F6). */
  .writers { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-top: clamp(24px, 3vw, 34px); }
  @media (max-width: 980px){ .au-hero { grid-template-columns: 1fr; align-items: start; } }

  /* Styles en ligne du héros de la référence, portés en classes (valeurs
     inchangées) — à reprendre dans le DS avec le bloc ci-dessus. */
  .au-hero h1 { font-size: clamp(36px, 4.8vw, 64px); margin-top: 16px; }
  .au-hero h1 em { font-style: normal; color: var(--green); }
  .au-hero .au-lede { color: var(--ink-soft); font-size: 17px; margin-top: 18px; max-width: 58ch; }

  /* Additif : chiffres en var(--serif) → display élargi (parti de local.css
     l. 10-13, où figure déjà .ah-stats .sv de la page auteur). */
  .au-stats .st .sv { font-stretch: var(--wide); }
</style>
