  <div class="legal">
    {/* TODO: switcher mentions/confidentialité/cookies/honoraires */}
    <aside>{/* TODO: sommaire sticky */}</aside>
    <div class="prose">
      <slot />
    </div>
  </div>
</PageLayout>
