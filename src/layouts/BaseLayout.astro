---
/**
 * Layout de base — fontes, favicons, script partagé du DS, JSON-LD Organization.
 *
 * `ds-script.js` est la copie de script.js du design system : header collant,
 * drawer, recherches, enhancer des <select>, visionneuse, révélations.
 * ATTENTION (synchro du 23 sept.) : il EXIGE #header, #burger, #drawer et
 * #drawerClose — gardes retirées côté DS. Toute page doit donc rendre le
 * chrome (SiteHeader) ou fournir ces ancres.
 */
import { organization, jsonLd } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  /** URL canonique absolue — indispensable sur les pages de localité */
  canonical?: string;
  /** Classe de fond du <body> si la page commence par une section teintée */
  bodyClass?: string;
  /** Passer à false quand la page émet son propre RealEstateAgent complet
      (slot head) — sinon deux blocs JSON-LD RealEstateAgent coexistent. */
  organizationLd?: boolean;
}
const { title, description, canonical, bodyClass = '', organizationLd = true } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Signe V de la marque -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <!-- Fonte de marque : préchargement, sinon le display bascule sur system-ui -->
    <link
      rel="preload"
      href="/fonts/AcuminVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />

    {organizationLd && (
      <script is:inline type="application/ld+json" set:html={jsonLd(organization())} />
    )}

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <script is:inline src="/ds-script.js"></script>
  </body>
</html>

<style is:global>
  @import "../styles/app.css";
</style>
