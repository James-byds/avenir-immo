---
/* Page courante : BaseLayout + TopBar + header + footer.
   La plupart des pages « intérieures » utilisent ce layout.

   BaseLayout attend header/footer via des SLOTS NOMMÉS et enveloppe lui-même
   le contenu par défaut dans <main> : on ne redouble donc pas le <main> ici.

   `solid` (défaut true) = header verre blanc ; le passer à false sur les
   pages à héros pleine hauteur (accueil) pour le header transparent.
   `active` = href de l'onglet de navigation à souligner.

   Le slot nommé `head` est relayé à BaseLayout (JSON-LD de page, balises
   spécifiques). Une page qui émet son propre RealEstateAgent complet passe
   `organizationLd={false}` pour couper le bloc minimal du BaseLayout. */
import BaseLayout from "./BaseLayout.astro";
import TopBar from "../components/chrome/TopBar.astro";
import SiteHeader from "../components/chrome/SiteHeader.astro";
import SiteFooter from "../components/chrome/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  bodyClass?: string;
  /** Header verre blanc (défaut) — false pour le header transparent sur héros. */
  solid?: boolean;
  /** href de la page courante — souligne l'onglet actif du header. */
  active?: string;
  /** false quand la page émet son propre RealEstateAgent (slot head). */
  organizationLd?: boolean;
}

const {
  title,
  description = "L'Avenir Immobilier — agence immobilière de prestige à Charleroi.",
  canonical,
  bodyClass,
  solid = true,
  active,
  organizationLd = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  bodyClass={bodyClass}
  organizationLd={organizationLd}
>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <Fragment slot="header">
    <TopBar />
    <SiteHeader solid={solid} active={active} />
  </Fragment>
  <slot />
  <SiteFooter slot="footer" />
</BaseLayout>
