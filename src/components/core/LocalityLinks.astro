---
/**
 * LocalityLinks — port .astro de components/core/LocalityLinks.jsx
 *
 * "widen" = bandeau « Élargir autour » sous les filtres (rendu null si vide).
 * "mesh"  = bloc groupé par intention. Les ancres sont DESCRIPTIVES (SEO).
 *
 * Étendu pour le gabarit liste des biens (24 sept. 2026, à reprendre dans
 * le DS) : `id` + `hidden` (le script de page n'affiche le bandeau widen que
 * pour 1 à 3 résultats — règle [hidden] de local.css) ; `Link.planned` pose
 * data-planned sur une ancre dont la page n'est pas encore codée.
 */
interface Link {
  text: string;
  href?: string;
  count?: number;
  current?: boolean;
  /** Page prévue mais non codée — rend data-planned (jamais href="#" nu). */
  planned?: boolean;
}
interface Group {
  label: string;
  links: Link[];
}
interface Props {
  variant?: "widen" | "mesh";
  label?: string;
  links?: Link[];
  eyebrow?: string;
  title?: string;
  groups?: Group[];
  class?: string;
  id?: string;
  hidden?: boolean;
  style?: string;
}
const {
  variant = "mesh",
  label = "Élargir autour",
  links = [],
  eyebrow = "Maillage",
  title,
  groups = [],
  class: className = "",
  id,
  hidden = false,
  style,
} = Astro.props;
---

{
  variant === "widen" ? (
    links.length === 0 ? null : (
      <div class={`ll-widen ${className}`.trim()} id={id} hidden={hidden} style={style}>
        <span class="ll-lab">{label}</span>
        <div class="ll-pills">
          {links.map((l) => (
            <a
              href={l.href || "#"}
              class={l.current ? "on" : undefined}
              aria-current={l.current ? "page" : undefined}
              data-planned={l.planned ? "" : undefined}
            >
              {l.text}
              {l.count != null && <span class="ll-n">{l.count}</span>}
            </a>
          ))}
        </div>
      </div>
    )
  ) : (
    <section class={`ll-mesh ${className}`.trim()} id={id} hidden={hidden} style={style}>
      {eyebrow && <span class="ll-lab">{eyebrow}</span>}
      {title && <h2>{title}</h2>}
      <div class="ll-rows">
        {groups.map((g) => (
          <div class="ll-row">
            <span class="ll-lab">{g.label}</span>
            <div class="ll-pills">
              {g.links.map((l) => (
                <a
                  href={l.href || "#"}
                  class={l.current ? "on" : undefined}
                  aria-current={l.current ? "page" : undefined}
                  data-planned={l.planned ? "" : undefined}
                >
                  {l.text}
                  {l.count != null && <span class="ll-n">{l.count}</span>}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}
