---
/**
 * Eyebrow — port .astro de components/core/Eyebrow.jsx
 *
 * Filet + capitales espacées. La couleur (vert sur clair, jaune sur sombre)
 * est décidée par le contexte dans site.css — rien à porter ici.
 */
interface Props {
  /** Centré, sans trait — pour sections centrées */
  center?: boolean;
}
const { center = false } = Astro.props;
---

<span class={`eyebrow${center ? " center" : ""}`}><slot /></span>
