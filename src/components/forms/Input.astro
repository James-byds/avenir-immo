---
/**
 * Input — port .astro de components/forms/Input.jsx
 *
 * Champ .field : label + input. Les attributs supplémentaires (type, name,
 * placeholder, required, value…) sont transmis à l'<input>.
 */
interface Props {
  label: string;
  [key: string]: any;
}
const { label, ...rest } = Astro.props;
---

<div class="field">
  <label>{label}</label>
  <input {...rest} />
</div>
