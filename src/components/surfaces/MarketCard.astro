---
/**
 * MarketCard — carte riche d'un marché du hub des localités (gabarit 04).
 *
 * Réf. : docs/handoff/reference/localites.html, section « Nos trois marchés ».
 * Balisage de la référence : .card du DS + motifs .loc-figs / .loc-who /
 * .ll-pills (bloc « hub des localités » de local.css — dans une .card-body de
 * .prop-grid, les pilules deviennent une liste de liens filetés).
 *
 * Cette carte porte PLUSIEURS liens (conseiller + maillage) : pas de lien
 * étendu à la carte — la règle « un seul lien, étendu » ne vaut que pour les
 * cartes à lien unique. Aucun compteur affiché : ancres descriptives.
 * Les styles inline (taille du nom, corps 15 px) sont ceux de la référence.
 */
interface Fig {
  /** Valeur affichée (« 385 000 € », « +4,2 % ») — sourcée côté page. */
  valeur: string;
  label: string;
}
interface Lien {
  text: string;
  href: string;
  /** Page prévue mais non codée — rend data-planned (jamais href="#" nu). */
  planned?: boolean;
}
interface Props {
  /** Nom du marché (« Grand Charleroi »). */
  nom: string;
  /** Titre de la carte (h3). */
  titre: string;
  texte: string;
  /** Légende du placeholder photo. */
  photoTag: string;
  figs: Fig[];
  conseiller: {
    nom: string;
    /** « Votre conseiller ici ». */
    role: string;
    tel?: string;
    /** Profil /equipe/<id>. */
    href: string;
    photo?: string;
  };
  liens: Lien[];
  class?: string;
}
const { nom, titre, texte, photoTag, figs, conseiller, liens, class: className = "" } = Astro.props;
const initiales = conseiller.nom
  .split(" ")
  .map((m) => m[0])
  .slice(0, 2)
  .join("");
---

<article class={`card ${className}`.trim()}>
  <div class="card-media">
    <div class="ph"><span class="ph-tag">{photoTag}</span></div>
  </div>
  <div class="card-body">
    <div class="card-row"><span class="card-price" style="font-size:22px">{nom}</span></div>
    <h3>{titre}</h3>
    <p style="color:var(--ink-soft);font-size:15px;margin-top:10px">{texte}</p>
    <div class="loc-figs">
      {figs.map((f) => (
        <div class="lf"><span class="lf-v">{f.valeur}</span><span class="lf-k">{f.label}</span></div>
      ))}
    </div>
    <a class="loc-who" href={conseiller.href}>
      <span class="byline">
        <span class="b-av" aria-hidden="true">
          {conseiller.photo ? <img src={conseiller.photo} alt="" loading="lazy" /> : initiales}
        </span>
        <span><span class="b-name">{conseiller.nom}</span><span class="b-role">{conseiller.role}</span></span>
      </span>
      {conseiller.tel && <span class="loc-tel">{conseiller.tel} <span class="arr">→</span></span>}
    </a>
    <div class="ll-pills">
      {liens.map((l) => (
        <a href={l.href} data-planned={l.planned ? "" : undefined}>{l.text}</a>
      ))}
    </div>
  </div>
</article>
