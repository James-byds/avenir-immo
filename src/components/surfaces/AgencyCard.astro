---
/**
 * AgencyCard — port .astro de components/surfaces/AgencyCard.jsx
 *
 * Une seule agence : `media="photo"` (vitrine) ou `media="map"` (plan + pastille).
 * `zones` = pilules vers les pages de localité (maillage interne).
 */
interface Row {
  label: string;
  value: string;
  /** Ligne cliquable (tel:, mailto:) — référence a-propos.html. */
  href?: string;
}
import MapLeaflet from "../islands/MapLeaflet";

type Zone = string | { label: string; href?: string };
interface Props {
  media?: "photo" | "map";
  mediaLabel?: string;
  photo?: string;
  /** Coordonnées GPS — activent la carte Leaflet (îlot) quand media="map" */
  lat?: number;
  lng?: number;
  zoom?: number;
  tag?: string;
  name?: string;
  address?: string;
  note?: string;
  open?: string;
  rows?: Row[];
  phone?: string;
  /** Libellé du bouton téléphone (défaut : le numéro) — « Appeler l'agence ». */
  phoneLabel?: string;
  directionsHref?: string;
  directionsLabel?: string;
  /** Itinéraire en .btn plein et téléphone en ghost (référence contact.html) ;
      par défaut l'inverse (référence a-propos.html). */
  directionsPrimary?: boolean;
  /** Flèche du lien itinéraire : « → » (contact) ou « ↗ » (a-propos). */
  directionsArrow?: string;
  zones?: Zone[];
  zonesLabel?: string;
  class?: string;
}
const {
  media = "photo",
  mediaLabel,
  photo,
  lat,
  lng,
  zoom = 15,
  tag = "Agence",
  name,
  address,
  note,
  open,
  rows = [],
  phone,
  phoneLabel,
  directionsHref = "#",
  directionsLabel = "Itinéraire",
  directionsPrimary = false,
  directionsArrow = "→",
  zones = [],
  zonesLabel = "Zones d'intervention",
  class: className = "",
} = Astro.props;
const label = mediaLabel || (media === "map" ? "Plan — " + (name || "") : "Vitrine — " + (name || ""));

/* `tag` ET `open` cumulés quand le tag est passé explicitement (référence
   contact.html : badge en tête, horaire après l'adresse) ; sinon `open` seul
   prend la tête (référence a-propos.html) — comportement historique intact. */
const hasTag = "tag" in Astro.props;

/* Lien itinéraire externe (Google Maps) → nouvel onglet, comme la référence. */
const directionsExternal = /^https?:/i.test(directionsHref);
const telAttr = phone ? `tel:${phone.replace(/[^+0-9]/g, "")}` : undefined;
---

<article class={`agc ${className}`.trim()}>
  <div class="agc-media">
    {
      photo ? (
        <img src={photo} alt={label} class="agc-img" />
      ) : media === "map" && lat != null && lng != null ? (
        <MapLeaflet client:visible lat={lat} lng={lng} zoom={zoom} label={name} />
      ) : (
        <div class="ph"><span class="ph-tag">{label}</span></div>
      )
    }
    {media === "map" && !photo && (lat == null || lng == null) && <span class="map-pin" />}
  </div>
  <div class="agc-body">
    {hasTag && open ? <span class="ag-tag">{tag}</span> : open ? <span class="ag-open">{open}</span> : tag ? <span class="ag-tag">{tag}</span> : null}
    {name && <div class="ag-name">{name}</div>}
    {address && <p class="ag-addr">{address}{note ? " · " + note : ""}</p>}
    {hasTag && open && <span class="ag-open">{open}</span>}
    {
      rows.length > 0 && (
        <dl class="ag-rows">
          {rows.map((r) => (
            <div class="ag-row">
              <dt>{r.label}</dt>
              <dd>{r.href ? <a href={r.href}>{r.value}</a> : r.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    {
      (phone || directionsHref) && (
        <div class="agc-act">
          {directionsPrimary ? (
            <>
              {directionsHref && (
                <a
                  class="btn"
                  href={directionsHref}
                  target={directionsExternal ? "_blank" : undefined}
                  rel={directionsExternal ? "noopener" : undefined}
                >{directionsLabel} <span class="arr">{directionsArrow}</span></a>
              )}
              {phone && <a class="btn btn--ghost" href={telAttr}>{phoneLabel ?? phone}</a>}
            </>
          ) : (
            <>
              {phone && <a class="btn" href={telAttr}>{phoneLabel ?? phone}</a>}
              {directionsHref && (
                <a
                  class="btn btn--ghost"
                  href={directionsHref}
                  target={directionsExternal ? "_blank" : undefined}
                  rel={directionsExternal ? "noopener" : undefined}
                >{directionsLabel} <span class="arr">{directionsArrow}</span></a>
              )}
            </>
          )}
        </div>
      )
    }
    {
      zones.length > 0 && (
        <div class="ag-zones">
          <span class="z-label">{zonesLabel}</span>
          <ul>
            {zones.map((z) => (
              <li>
                <a href={typeof z === "string" ? "#" : z.href || "#"}>
                  {typeof z === "string" ? z : z.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>

<style>
  /* Photo cliente dans le cadre média (ratio de la référence) — à reprendre dans le DS. */
  .agc-img { display: block; width: 100%; aspect-ratio: 16 / 8.2; object-fit: cover; }
  /* Référence (a-propos.html : liens tel/mail des ag-rows en color:inherit
     inline) — à reprendre dans le DS. */
  .ag-rows dd a {
    color: inherit;
  }
</style>
