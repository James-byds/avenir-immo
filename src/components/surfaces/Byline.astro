---
/**
 * Byline — port .astro de components/surfaces/Byline.jsx
 *
 * Signature d'auteur d'article (distinct des agents et des membres d'équipe).
 * Cliquable si `href`. L'avatar affiche les initiales déduites du nom.
 */
interface Props {
  name: string;
  role?: string;
  meta?: string;
  initials?: string;
  small?: boolean;
  href?: string;
  [key: string]: any;
}
const { name, role, meta, initials, small = false, href, ...rest } = Astro.props;
const av = initials || (name || "").split(" ").map((w) => w[0]).slice(0, 2).join("");
const Tag = href ? "a" : "div";
---

<Tag class={`byline${small ? " byline--sm" : ""}`} href={href} {...rest}>
  <span class="b-av">{av}</span>
  <span>
    <span class="b-name">{name}</span>{role && <span class="b-role"> · {role}</span>}
    {meta && <span class="b-meta" style="display:block">{meta}</span>}
  </span>
</Tag>
