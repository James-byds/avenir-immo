---
/**
 * PropertyCard — port .astro de components/surfaces/PropertyCard.jsx
 *
 * Compose Badge + Placeholder (comme le composant du DS). Le badge « flottant »
 * passe par .card-badge (jaune si "new", encre si "sold") — pas par des classes
 * ad hoc.
 *
 * Variantes CONTEXTUELLES, jamais liées au device :
 *   défaut      grilles (liste des biens, biens similaires)
 *   overlay     mise en avant éditoriale — photo plein cadre + dégradé ; jamais en grille dense
 *   horizontal  vues denses (liste + carte, widgets colonne)
 *
 * `tag` (légende du placeholder) est remplacé par une <img> quand les visuels
 * arrivent : même emplacement, rien d'autre.
 *
 * À REPRENDRE DANS LE DS (24 sept. 2026) : passe-through optionnel `class`
 * + attributs `data-*` posés sur l'<article> — la liste des biens filtre
 * côté client sur data-cat/loc/type/price/surface/idx et pose .reveal.
 * Rétro-compatible : sans ces props, le rendu est inchangé.
 */
import Badge from "./Badge.astro";
import Placeholder from "../core/Placeholder.astro";

interface Props {
  variant?: "overlay" | "horizontal";
  price: string;
  /** Suffixe du prix, ex. « / mois » pour une location */
  suffix?: string;
  location: string;
  title: string;
  specs?: string[];
  badge?: string;
  badgeVariant?: "new" | "sold";
  /** Légende du placeholder, en attente de la photo */
  tag?: string;
  /** Indice PEB (A++ … G) — pastille .card-peb de local.css */
  peb?: string;
  href?: string;
  /** Classes additionnelles de l'<article> (ex. .reveal .d1). */
  class?: string;
  /** Attributs data-* de l'<article> (filtrage client de la liste). */
  [key: `data-${string}`]: string | number | undefined;
}
const {
  variant,
  price,
  suffix,
  location,
  title,
  specs = [],
  badge,
  badgeVariant,
  tag,
  peb,
  href = "#",
  class: className,
  ...rest
} = Astro.props;

/* Seuls les data-* passent — aucun autre attribut libre. */
const dataAttrs = Object.fromEntries(
  Object.entries(rest).filter(([k]) => k.startsWith("data-")),
);
const extra = className ? ` ${className}` : "";

const isOverlay = variant === "overlay";
const isHorizontal = variant === "horizontal";
---

{
  isOverlay ? (
    <article class={`card card--overlay${extra}`} {...dataAttrs}>
      <a href={href} class="card-link" aria-label={title} />
      {badge && (
        <Badge floating variant={badgeVariant}>
          {badge}
        </Badge>
      )}
      <button class="card-fav" aria-label="Ajouter aux favoris">♡</button>
      <Placeholder green tag={tag} ratio="4 / 4.4" />
      <div class="ov">
        <span class="card-loc">{location}</span>
        <h3>{title}</h3>
        <span class="card-price">
          {price}
          {suffix && <span class="card-suffix"> {suffix}</span>}
        </span>
        {specs.length > 0 && (
          <div class="card-specs">
            {specs.map((s) => (
              <span>
                <i />
                {s}
              </span>
            ))}
          </div>
        )}
        {peb && (
          <div class="card-peb">
            <span class="pb" data-peb={peb}>{peb}</span>
            <span class="pv">Certificat PEB</span>
          </div>
        )}
      </div>
    </article>
  ) : (
    <article class={`card${isHorizontal ? " card--h" : ""}${extra}`} {...dataAttrs}>
      <a href={href} class="card-link" aria-label={title} />
      <div class="card-media">
        {badge && (
          <Badge floating variant={badgeVariant}>
            {badge}
          </Badge>
        )}
        <button class="card-fav" aria-label="Ajouter aux favoris">♡</button>
        <Placeholder tag={tag} ratio="4 / 3.1" />
      </div>
      <div class="card-body">
        <div class="card-row">
          <span class="card-price">
            {price}
            {suffix && <span class="card-suffix"> {suffix}</span>}
          </span>
          {!isHorizontal && <span class="card-loc">{location}</span>}
        </div>
        <h3>{title}</h3>
        {isHorizontal && <span class="card-loc mt-2">{location}</span>}
        {specs.length > 0 && (
          <div class="card-specs">
            {specs.map((s) => (
              <span>
                <i />
                {s}
              </span>
            ))}
          </div>
        )}
        {peb && (
          <div class="card-peb">
            <span class="pb" data-peb={peb}>{peb}</span>
            <span class="pv">Certificat PEB</span>
          </div>
        )}
      </div>
    </article>
  )
}

<style>
@layer ds {
  /* à reprendre dans le DS — suffixe du prix (« /mois ») en 14 px atténué — style inline de la maquette. */
  .card-suffix { font-size: 14px; color: var(--ink-mute); }
}
</style>
