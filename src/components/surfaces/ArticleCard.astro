---
/**
 * ArticleCard — port .astro de components/surfaces/ArticleCard.jsx
 *
 * "feature" = carte horizontale teintée (tête de hub) — une seule par écran.
 * "compact" = carte resserrée (« à lire aussi », colonne, mobile), option `thumb`.
 */
import Byline from "./Byline.astro";

interface Author {
  name: string;
  role?: string;
  href?: string;
}
interface Props {
  variant?: "feature" | "compact";
  tint?: boolean;
  thumb?: boolean;
  category?: string;
  meta?: string;
  title?: string;
  excerpt?: string;
  author?: Author;
  href?: string;
  photo?: string;
  mediaLabel?: string;
  ctaLabel?: string;
  class?: string;
}
const {
  variant = "feature",
  tint = false,
  thumb = false,
  category,
  meta,
  title,
  excerpt,
  author,
  href = "#",
  photo,
  mediaLabel = "Photo d'article",
  ctaLabel = "Lire",
  class: className = "",
} = Astro.props;
const isCompact = variant === "compact";
---

{
  isCompact ? (
    <a class={`art-mini${tint ? " art-mini--tint" : ""} ${className}`.trim()} href={href}>
      {thumb ? (
        <div class="am-thumb">
          {photo ? (
            <img src={photo} alt={mediaLabel} style="display:block;width:100%;aspect-ratio:1 / 1;object-fit:cover;border-radius:var(--r-sm)" />
          ) : (
            <div class="ph" />
          )}
          <div>
            <div class="am-row">
              {category && <span class="art-cat art-cat--soft">{category}</span>}
              {meta && <span class="art-meta">{meta}</span>}
            </div>
            <h3>{title}</h3>
          </div>
        </div>
      ) : (
        <>
          <div class="am-row">
            {category && <span class="art-cat art-cat--soft">{category}</span>}
            {meta && <span class="art-meta">{meta}</span>}
          </div>
          <h3>{title}</h3>
        </>
      )}
      {author && !thumb && (
        <Byline name={author.name} role={author.role} meta={meta ? undefined : author.role} small />
      )}
    </a>
  ) : (
    <a class={`art-feature ${className}`.trim()} href={href}>
      <div class="af-media">
        {category && <span class="art-cat">{category}</span>}
        {photo ? (
          <img src={photo} alt={mediaLabel} style="display:block;width:100%;height:100%;object-fit:cover" />
        ) : (
          <div class="ph">
            <span class="ph-tag">{mediaLabel}</span>
          </div>
        )}
      </div>
      <div class="af-body">
        {meta && <span class="art-meta">{meta}</span>}
        <h3>{title}</h3>
        {excerpt && <p>{excerpt}</p>}
        <div class="af-foot">
          {author && <Byline name={author.name} role={author.role} small />}
          <span class="link-arrow">{ctaLabel}<span class="arr">→</span></span>
        </div>
      </div>
    </a>
  )
}
