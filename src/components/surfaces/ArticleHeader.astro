---
/**
 * ArticleHeader — port .astro de components/surfaces/ArticleHeader.jsx
 *
 * En-tête de page article (.art-head) : .ah-top (catégorie en aplat vert
 * clair texte encre + date), H1, chapô .ah-lede, .ah-foot (Byline 44 px
 * CLIQUABLE vers la page auteur — c'est ici, hors carte, que la signature
 * est un lien — + pastille .ah-read), emplacement photo .ah-media.
 * `size="compact"` pour colonne latérale / petit écran ; `showMedia={false}`
 * sans visuel. Le chapô accepte du HTML léger (<strong>, liens).
 */
import Byline from "./Byline.astro";

interface Author {
  name: string;
  role?: string;
  href?: string;
}
interface Props {
  size?: "large" | "compact";
  category?: string;
  date?: string;
  title: string;
  lede?: string;
  author?: Author;
  readTime?: string;
  photo?: { src: string; alt: string };
  mediaLabel?: string;
  showMedia?: boolean;
  class?: string;
}
const {
  size = "large",
  category,
  date,
  title,
  lede,
  author,
  readTime,
  photo,
  mediaLabel = "Photo d'article",
  showMedia = true,
  class: className = "",
} = Astro.props;
const isCompact = size === "compact";
const cls = ["art-head", isCompact && "art-head--sm", className].filter(Boolean).join(" ");
---

<header class={cls}>
  <div class="ah-top">
    {category && <span class="art-cat">{category}</span>}
    {date && <span class="art-meta">{date}</span>}
  </div>
  <h1>{title}</h1>
  {lede && <p class="ah-lede" set:html={lede} />}
  {
    (author || readTime) && (
      <div class="ah-foot">
        {author && <Byline name={author.name} role={author.role} small={isCompact} href={author.href} />}
        {readTime && <span class="ah-read">{readTime}</span>}
      </div>
    )
  }
  {
    showMedia && (
      <div class="ah-media">
        {photo ? (
          <img class="ah-img" src={photo.src} alt={photo.alt} loading="lazy" />
        ) : (
          <div class="ph">
            <span class="ph-tag">{mediaLabel}</span>
          </div>
        )}
      </div>
    )
  }
</header>

<style>
  /* Photo réelle : mêmes métriques que le placeholder .ah-media .ph du DS
     (16/6.2, 16/9 en compact, rayon --r) — remplace le style inline du port. */
  .ah-media .ah-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 6.2;
    object-fit: cover;
    border-radius: var(--r);
  }
  .art-head--sm .ah-media .ah-img {
    aspect-ratio: 16 / 9;
  }
</style>
