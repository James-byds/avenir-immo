---
/**
 * ArticleHeader — port .astro de components/surfaces/ArticleHeader.jsx
 *
 * En-tête de page article : catégorie, titre, chapô, signature, temps de lecture.
 * `size="compact"` pour colonne latérale / petit écran ; `showMedia={false}` sans visuel.
 */
import Byline from "./Byline.astro";

interface Author {
  name: string;
  role?: string;
  href?: string;
}
interface Props {
  size?: "large" | "compact";
  category?: string;
  date?: string;
  title?: string;
  lede?: string;
  author?: Author;
  readTime?: string;
  photo?: string;
  mediaLabel?: string;
  showMedia?: boolean;
  class?: string;
}
const {
  size = "large",
  category,
  date,
  title,
  lede,
  author,
  readTime,
  photo,
  mediaLabel = "Photo d'article",
  showMedia = true,
  class: className = "",
} = Astro.props;
const isCompact = size === "compact";
---

<header class={`art-head${isCompact ? " art-head--sm" : ""} ${className}`.trim()}>
  <div class="ah-top">
    {category && <span class="art-cat">{category}</span>}
    {date && <span class="art-meta">{date}</span>}
  </div>
  {title && <h1>{title}</h1>}
  {lede && <p class="ah-lede">{lede}</p>}
  {
    (author || readTime) && (
      <div class="ah-foot">
        {author && <Byline name={author.name} role={author.role} small={isCompact} href={author.href} />}
        {readTime && <span class="ah-read">{readTime}</span>}
      </div>
    )
  }
  {
    showMedia && (
      <div class="ah-media">
        {photo ? (
          <img
            src={photo}
            alt={mediaLabel}
            style={`display:block;width:100%;aspect-ratio:${isCompact ? "16 / 9" : "16 / 6.2"};object-fit:cover;border-radius:var(--r)`}
          />
        ) : (
          <div class="ph">
            <span class="ph-tag">{mediaLabel}</span>
          </div>
        )}
      </div>
    )
  }
</header>
