---
/**
 * AuthorBox — port .astro de components/surfaces/AuthorBox.jsx
 *
 * Encadré « À propos de l'auteur » — max 1 par page, toujours APRÈS le corps
 * de l'article. Un seul lien : « Tous ses articles → » vers la page auteur
 * (le nom n'est pas un second lien vers la même cible). La marge haute est
 * celle du DS (.author-box) — la page la surcharge par classe, jamais en
 * style inline.
 */
import LinkArrow from "../core/LinkArrow.astro";

interface Props {
  name: string;
  role?: string;
  bio?: string;
  initials?: string;
  href?: string;
  linkLabel?: string;
  class?: string;
}
const {
  name,
  role,
  bio,
  initials,
  href,
  linkLabel = "Tous ses articles",
  class: className = "",
} = Astro.props;
const av =
  initials ||
  (name || "")
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join("");
const cls = ["author-box", className].filter(Boolean).join(" ");
---

<aside class={cls}>
  <span class="b-av" aria-hidden="true">{av}</span>
  <div>
    <div class="ab-tag">À propos de l'auteur</div>
    <div class="ab-name">{name}</div>
    {role && <div class="ab-role">{role}</div>}
    {bio && <p class="ab-bio">{bio}</p>}
    {href && <LinkArrow href={href}>{linkLabel}</LinkArrow>}
  </div>
</aside>
