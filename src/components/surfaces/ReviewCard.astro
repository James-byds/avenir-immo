---
/**
 * ReviewCard — carte d'avis du mur `/avis` (réf. docs/handoff/reference/avis.html).
 *
 * `.t-card` du DS + variantes propres au mur : pastille `.t-chip` (type de
 * projet, stylée dans local.css), date `.t-date` avec logo Google, réponse
 * publique `.t-reply`, photos jointes `.t-photos` (placeholders `.ph` —
 * remplacer chaque .ph par un <img> quand les visuels arriveront), avis
 * vedette `.t-card--hl` (panneau vert profond, local.css).
 *
 * Distinct du `.t-card--photo` de TrustSection : sur le mur de la référence,
 * les photos sont des blocs `.t-photos` dans des cartes ordinaires.
 *
 * L'avatar est calculé depuis le nom (même fonction que TrustSection) —
 * décoratif, aria-hidden.
 */
interface Props {
  auteur: string;
  note: number;
  texte: string;
  /** Contexte affiché sous le nom (« Vente d'une villa · Gerpinnes »). */
  place: string;
  /** Clé de filtre (data-cat) — « vente », « achat », « estimation », « offmarket ». */
  cat?: string;
  /** Libellé de la pastille (« Vente », « Off-market »). */
  chip?: string;
  /** Date affichée (« sept. 2026 »). */
  dateLabel: string;
  /** Réponse publique de l'agence. */
  reponse?: string;
  /** Étiquettes des photos jointes (placeholders en attente des visuels). */
  photos?: string[];
  /** Avis vedette — .t-card--hl (panneau vert profond). */
  highlight?: boolean;
  /** Carte au-delà de la première page du mur — .pg-hid (révélée par « En voir plus »). */
  hidden?: boolean;
  class?: string;
}
const {
  auteur,
  note,
  texte,
  place,
  cat,
  chip,
  dateLabel,
  reponse,
  photos,
  highlight = false,
  hidden = false,
  class: className,
} = Astro.props;

const initials = (name: string) =>
  name.split(" ").filter((w) => /^\p{L}/u.test(w)).map((w) => w[0]).join("").slice(0, 2);

const pleines = "★★★★★".slice(0, note);
const creuses = "★★★★★".slice(note);
const nPhotos = photos?.length ?? 0;

const cls = [
  "t-card",
  highlight && "t-card--hl",
  className,
  hidden && "pg-hid",
]
  .filter(Boolean)
  .join(" ");
---

<article class={cls} data-cat={cat || undefined}>
  <div class="t-headrow">
    <span class="t-cstars" aria-label={`${note} étoiles sur 5`}>{pleines}{creuses && <span class="opacity-25">{creuses}</span>}</span>
    {chip && <span class="t-chip">{chip}</span>}
    <span class="t-date"><svg class="t-glogo" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg> {dateLabel}</span>
  </div>
  <p class="t-quote">{texte}</p>
  {nPhotos > 0 && photos && (
    <div class="t-photos" aria-label={`${nPhotos} photo${nPhotos > 1 ? "s" : ""} jointe${nPhotos > 1 ? "s" : ""} à l'avis`}>
      {nPhotos === 1 ? (
        <div class="ph wide col-span-3 aspect-[16/7]"><span class="ph-tag">{photos[0]}</span></div>
      ) : (
        photos.map((tag, i) => (
          <div class={`ph${nPhotos === 2 && i === 0 ? " wide" : ""}`}><span class="ph-tag">{tag}</span></div>
        ))
      )}
    </div>
  )}
  {reponse && (
    <div class="t-reply">
      <span class="r-tag">Réponse d'Avenir Immobilier</span>
      <p>{reponse}</p>
    </div>
  )}
  <div class="t-meta">
    <span class="t-ava" aria-hidden="true">{initials(auteur)}</span>
    <span>
      <span class="t-name">{auteur}</span>
      <br />
      <span class="t-place">{place}</span>
    </span>
  </div>
</article>

<style is:global>
@layer ds {
  /* ── à reprendre dans le DS — gabarit 09 : <style> de page de avis.html
     (cartes du mur), valeurs inchangées. local.css ne porte que les
     surcharges de contexte (#mur .t-reply, #mur .t-photos .ph, .t-chip)
     et le display inline-flex de .t-date — la base manque. ── */
  .t-date { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-mute); }
  .t-reply { background: var(--bg); border: 1px solid var(--line-2); border-radius: var(--r-sm); padding: 14px 16px; margin-top: -4px; }
  .t-reply .r-tag { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--green-d); }
  .t-reply p { font-size: 13.5px; line-height: 1.55; color: var(--ink-soft); margin-top: 7px; }
  .t-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: -4px; }
  .t-photos .ph { aspect-ratio: 4 / 3; border-radius: var(--r-sm); cursor: zoom-in; transition: opacity .25s; }
  .t-photos .ph:hover { opacity: .85; }
  .t-photos .ph.wide { grid-column: span 2; }
  .t-photos .ph-tag { font-size: 9px; }
}
</style>
