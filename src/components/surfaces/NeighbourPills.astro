---
/**
 * NeighbourPills — « Immobilier dans les communes voisines » (.q-others).
 *
 * Section blanche courte (.sec--short — reprise en classe du
 * style="padding-block:clamp(40px,5vw,60px)" de la référence quartier.html).
 * Les pilules .q-pill pointent vers des pages de localité : tant qu'une page
 * n'est pas codée, sa pilule porte `planned` → data-planned SANS href (jamais
 * de lien vers une 404), l'URL prévue étant conservée en data-href.
 */
import Eyebrow from "../core/Eyebrow.astro";

interface Lien {
  label: string;
  href: string;
  /** Page prévue mais non codée — pose data-planned. */
  planned?: boolean;
}
interface Props {
  eyebrow: string;
  titre: string;
  liens: Lien[];
}
const { eyebrow, titre, liens } = Astro.props;
---

<section class="sec--white sec--short">
  <div class="wrap">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="np-title mt-3">{titre}</h2>
    <div class="q-others">
      {
        liens.map((l) => (
          <a class="q-pill" href={l.planned ? undefined : l.href} data-href={l.planned ? l.href : undefined} data-planned={l.planned ? "" : undefined}>{l.label} →</a>
        ))
      }
    </div>
  </div>
</section>

<style>
@layer ds {
  /* à reprendre dans le DS — quartier.html : taille du H2 « communes voisines » (style inline de la maquette). */
  .np-title { font-size: clamp(21px, 2.4vw, 26px); }
}
</style>
