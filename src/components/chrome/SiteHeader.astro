---
/**
 * SiteHeader — en-tête du site (chrome, hors composants DS).
 *
 * Balisage attendu par ds-script.js (SANS gardes depuis la synchro du
 * 23 sept.) : #header, #burger, #drawer et #drawerClose doivent exister
 * sur toutes les pages. Le drawer se ferme au clic sur un lien.
 *
 * Deux logos superposés (image cliente, jamais redessinée) :
 * `.brand-logo--ink` (couleur) / `.brand-logo--rev` (blanc) — la bascule
 * au scroll est du pur CSS via la classe `.scrolled` posée par ds-script.js.
 * `solid` = verre blanc (pages intérieures) ; sans = transparent sur héros.
 *
 * L'état initial du drawer est un style inline transform/visibility
 * (anti-flash avant CSS) que openDrawer() retire — contrat du script.
 */
interface NavItem {
  label: string;
  href: string;
  /** Page prévue mais non encore codée : le lien porte data-planned (cf. local.css). */
  planned?: boolean;
}
interface Props {
  /** Header verre blanc (pages intérieures). Sans : transparent sur héros. */
  solid?: boolean;
  /** href de la page courante — souligne l'onglet actif. */
  active?: string;
}
const { solid = true, active } = Astro.props;

const nav: NavItem[] = [
  { label: "Nos biens", href: "/biens" },
  { label: "Quartiers", href: "/communes" },
  { label: "Estimation", href: "/estimation" },
  { label: "L'agence", href: "/a-propos" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<header id="header" class={`header${solid ? " header--solid" : ""}`}>
  <div class="wrap nav">
    <a href="/" class="brand" aria-label="Avenir Immobilier, accueil">
      <img src="/assets/logo-lavenir-immobilier.png" alt="L'aVenir immobilier" class="brand-logo brand-logo--ink" width="695" height="652" />
      <img src="/assets/logo-lavenir-immobilier-blanc.png" alt="" aria-hidden="true" class="brand-logo brand-logo--rev" width="806" height="735" />
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      {nav.map((n) => <a href={n.href} class={active === n.href ? "on" : undefined} data-planned={n.planned ? "" : undefined}>{n.label}</a>)}
    </nav>
    <div class="nav-cta">
      <a class="nav-phone" href="tel:+3271321470"><span class="u-dot"></span>+32 71 32 14 70</a>
      <a href="/estimation" class="btn">Estimer mon bien <span class="arr">→</span></a>
      <button
        id="burger"
        class="burger"
        type="button"
        aria-label="Ouvrir le menu"
        aria-controls="drawer"
        aria-expanded="false"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Style inline = ÉTAT INITIAL lu par ds-script.js (openDrawer retire ces deux
     propriétés) : évite le flash du tiroir avant le chargement du script. Toléré
     en recette comme valeur d'exécution. -->
<div class="drawer" id="drawer" aria-hidden="true" style="transform:translateX(100%);visibility:hidden">
  <div class="drawer-top">
    <img src="/assets/logo-lavenir-immobilier.png" alt="L'aVenir immobilier" class="brand-logo" width="695" height="652" />
    <button id="drawerClose" class="drawer-close" type="button" aria-label="Fermer">×</button>
  </div>
  <nav aria-label="Navigation mobile">
    {nav.map((n) => <a href={n.href} data-planned={n.planned ? "" : undefined}>{n.label}</a>)}
  </nav>
  <a href="/estimation" class="btn btn--block">Estimer mon bien <span class="arr">→</span></a>
</div>

<style>
@layer ds {
  /* Point vert du téléphone : la référence le pose en style inline
     (background:var(--green)) — défaut de maquette recopié ici en scoped,
     valeur inchangée. À reprendre dans le DS (.nav-phone .u-dot). */
  .nav-phone .u-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
    display: inline-block;
  }
}
</style>

<script>
  /* Complément clavier du tiroir — ds-script.js ouvre/ferme mais ne
     synchronise pas aria-expanded, ne déplace pas le focus et ignore Échap
     (vigilance 20 du handoff). À reprendre dans le DS. */
  const burger = document.getElementById("burger");
  const drawer = document.getElementById("drawer");
  const closeBtn = document.getElementById("drawerClose");
  const sync = () =>
    burger?.setAttribute("aria-expanded", drawer?.classList.contains("open") ? "true" : "false");
  burger?.addEventListener("click", () => setTimeout(() => { sync(); closeBtn?.focus(); }, 60));
  closeBtn?.addEventListener("click", () => setTimeout(() => { sync(); burger?.focus(); }, 0));
  drawer?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setTimeout(sync, 0)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer?.classList.contains("open")) closeBtn?.click();
  });
</script>
