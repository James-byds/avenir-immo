---
/**
 * PageHead — en-tête de page intérieure (chrome).
 *
 * Quatre variantes de fond (cf. handoff-rythme-visuel.md) :
 *   plain — clair (défaut) · band — bandeau encre + emplacement photo 48 %
 *   à droite · ink — bandeau encre sans photo (fiche bien : la galerie occupe
 *   le cadre) · tint — vert tendre, pour les en-têtes riches (blog, localités,
 *   légales) que l'encre rendrait illisibles.
 *
 * Slots :
 *   breadcrumb — fil d'Ariane ; défaut — section-head (eyebrow + h1 + p),
 *   galerie, filtres… ; aside — action alignée à droite du fil d'Ariane
 *   (ex. « Vous cherchez à louer ? » sur les localités, via .bc-row).
 *
 * L'emplacement photo de --band est un placeholder .ph : remplacer par un
 * <img> au même endroit quand les visuels de l'agence arriveront.
 */
interface Props {
  variant?: "plain" | "band" | "ink" | "tint";
  /** Libellé du placeholder photo de la variante band. */
  photoTag?: string;
}
const { variant = "plain", photoTag = "Photo d'en-tête — 1600 × 600" } = Astro.props;
const cls = `page-head${variant === "plain" ? "" : ` page-head--${variant}`}`;
const hasAside = Astro.slots.has("aside");
const hasBreadcrumb = Astro.slots.has("breadcrumb");
---

<section class={cls}>
  {variant === "band" && (
    <div class="ph pb-photo" aria-hidden="true"><span class="ph-tag">{photoTag}</span></div>
  )}
  <div class="wrap">
    {hasAside ? (
      <div class="bc-row">
        <slot name="breadcrumb" />
        <slot name="aside" />
      </div>
    ) : (
      hasBreadcrumb && <slot name="breadcrumb" />
    )}
    <slot />
  </div>
</section>
